---
// Bagian 3. Tulang punggung halaman, tujuh titik.
// Titik teal berarti berkasnya ada. Nov 2026 belum terjadi, jadi kosong.
const points = [
  {
    date: "Sep 2022",
    title: "Enrolled in Informatics at Universitas Islam Riau",
    note: "What followed ran four years to 144 credits, without a repeated course.",
    verified: true,
  },
  {
    date: "Feb 2024",
    title: "Vice chairman, HIMATIF",
    note: "Seven operational divisions and 50 members, reporting to the chair.",
    verified: true,
  },
  {
    date: "Oct 2024",
    title: "Desa Binaan, Pulau Gadang",
    note: "Community programme in Kampar. Pre-survey ran on 25 October.",
    verified: true,
  },
  {
    date: "Nov 2024",
    title: "Teaching assistant",
    note: "Six courses and nine classes over the four semesters that followed.",
    verified: true,
  },
  {
    date: "Mar 2025",
    title: "Journal article published, village internship begins",
    note: "I-Com Vol. 5 No. 1 on 10 March. OpenSID deployment starts the same month.",
    verified: true,
  },
  {
    date: "20 Jul 2026",
    title: "Thesis defended",
    note: "Passed outright, scored 82.07, graded A. Six credits, no revision round.",
    verified: true,
  },
  {
    date: "Nov 2026",
    title: "Commencement",
    note: "The degree was finished in July. What is left is the ceremony.",
    verified: false,
  },
];
---

<section class="section" id="timeline" aria-labelledby="timeline-title">
  <div class="shell">
    <span class="section__label">Timeline</span>
    <h2 id="timeline-title" class="rise">2022 to 2026</h2>

    <ol class="track">
      {
        points.map((p) => (
          <li
            class:list={[
              "track__point",
              "rise",
              { "track__point--open": !p.verified },
            ]}
          >
            <time class="figure track__date">{p.date}</time>
            <h3 class="track__title">{p.title}</h3>
            <p class="track__note">{p.note}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .track {
    position: relative;
    list-style: none;
    margin: 3rem 0 0;
    padding: 0 0 0 1.75rem;
    border-left: 1px solid var(--rule);
  }

  /* Garis teal yang tumbuh menutupi garis abu seiring halaman digulir.
     Panjang garis membaca sebagai kemajuan waktu, bukan dekorasi. */
  .track::before {
    content: "";
    position: absolute;
    left: -1px;
    top: 0;
    width: 1px;
    height: 100%;
    background: var(--verified);
    transform-origin: 50% 0;
    transform: scaleY(0);
  }

  @supports (animation-timeline: view()) {
    .track::before {
      animation: grow-y linear both;
      animation-timeline: view();
      animation-range: entry 65% exit 35%;
    }
  }

  .track__point {
    position: relative;
    padding-bottom: 2.5rem;
  }

  .track__point:last-child {
    padding-bottom: 0;
  }

  .track__point::before {
    content: "";
    position: absolute;
    left: calc(-1.75rem - 4.5px);
    top: 0.5rem;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--verified);
    transition:
      transform var(--t-mid) var(--ease-out),
      box-shadow var(--t-mid) var(--ease-out);
  }

  .track__point:hover::before {
    transform: scale(1.55);
    box-shadow: 0 0 0 5px var(--verified-wash);
  }

  .track__point--open::before {
    background: var(--paper);
    border: 1px solid var(--ink-soft);
  }

  .track__date {
    display: block;
    color: var(--ink-soft);
    margin-bottom: 0.35rem;
  }

  .track__title {
    font-size: var(--size-subhead);
    line-height: 1.3;
  }

  .track__note {
    max-width: var(--measure);
    margin-top: 0.35rem;
    color: var(--ink-soft);
  }

  @media (min-width: 52rem) {
    .track {
      padding-left: 2.5rem;
      /* Harus cukup lebar untuk menampung kolom tanggal di margin kiri:
         2,5rem padding + 8,1rem offset tanggal, dibulatkan ke atas. */
      margin-left: 8.5rem;
    }

    .track__point::before {
      left: calc(-2.5rem - 4.5px);
    }

    /* Tanggal berakhir di -3,6rem, titiknya duduk di -2,5rem. Selisih itu
       yang menjaga angka tidak tertimpa titik. */
    .track__date {
      position: absolute;
      left: -10.6rem;
      top: 0.15rem;
      width: 7rem;
      text-align: right;
      margin: 0;
    }
  }
</style>
