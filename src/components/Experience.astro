---
import { Image } from "astro:assets";
import labClass from "../assets/lab-class.jpeg";
import apbdesBefore from "../assets/apbdes-before.jpg";
import apbdesAfter from "../assets/apbdes-after.jpg";
import villageFinance from "../assets/village-finance.jpg";
import villagePresentation from "../assets/village-presentation.jpg";
import Compare from "./Compare.astro";

// Bagian 4. Sumber: Riwayat Pengalaman Dwi Yuda.
// "undergraduates" bukan "students". "hamlets" bukan "subvillages".
// Enam tugas akhir di bawah adalah review, bukan proyek pribadi.
//
// Bentuknya sengaja dibedakan dari bagian Organisasi: di sini kolom kiri
// menempel berisi angka jabatan, kanan mengalir. Di sana berupa lajur.
---

<section class="section" id="experience" aria-labelledby="experience-title">
  <div class="shell shell--wide">
    <span class="section__label">Experience</span>
    <h2 id="experience-title" class="rise">Two jobs, both finished</h2>

    <article class="post rise">
      <div class="post__meta">
        <h3 class="post__role">Teaching Assistant</h3>
        <p class="post__org figure">Universitas Islam Riau</p>
        <p class="post__when figure">Nov 2024 – Jun 2026</p>

        <dl class="spec">
          <div><dt>Courses</dt><dd class="figure">6</dd></div>
          <div><dt>Semesters</dt><dd class="figure">4</dd></div>
          <div><dt>Classes</dt><dd class="figure">9</dd></div>
          <div><dt>Undergraduates</dt><dd class="figure">~300</dd></div>
        </dl>
      </div>

      <div class="post__body">
        <ul class="post__points">
          <li>
            Ran lab sections for six courses over four semesters, from
            Introduction to Programming through to Statistics and Probability.
          </li>
          <li>
            Wrote the Statistics and Probability practicum myself and taught it:
            Z-test, T-test, ANOVA, confidence intervals.
          </li>
          <li>
            Built the SQL lab modules on subqueries, views, and concurrency
            control. Student queries got debugged live, mid-session.
          </li>
          <li>
            Reviewed six final-year projects across object detection, time
            series, clustering, and retrieval-augmented generation. Model setup,
            evaluation method, written report.
          </li>
        </ul>

        <figure class="shot">
          <Image
            src={labClass}
            alt="A computer lab at the end of a practicum session. Around
              thirty-five undergraduates stand and sit between two rows of
              monitors, facing the camera."
            widths={[720, 1200]}
            sizes="(min-width: 58rem) 46vw, 92vw"
            format="webp"
            quality={58}
            loading="lazy"
          />
          <figcaption class="caption">
            One of nine lab classes. Photograph used with permission.
          </figcaption>
        </figure>
      </div>
    </article>

    <article class="post rise">
      <div class="post__meta">
        <h3 class="post__role">Web Development Intern</h3>
        <p class="post__org figure">Pulau Gadang Village Government, Kampar</p>
        <p class="post__when figure">Mar – Aug 2025</p>

        <dl class="spec">
          <div><dt>Residents on file</dt><dd class="figure">1,794</dd></div>
          <div><dt>Households</dt><dd class="figure">517</dd></div>
          <div><dt>Articles kept</dt><dd class="figure">570</dd></div>
          <div><dt>Hamlets mapped</dt><dd class="figure">4</dd></div>
        </dl>
      </div>

      <div class="post__body">
        <ul class="post__points">
          <li>
            Deployed OpenSID v22.10 on PHP, CodeIgniter, and MariaDB as the
            village's official information system.
          </li>
          <li>
            Unlocked the User Group Management module, which OpenSID ships
            locked. Staff could then set their own access roles instead of
            sharing one administrator account.
          </li>
          <li>
            Gathered requirements with village staff, then checked every figure
            with the finance officer before writing code.
          </li>
          <li>
            Kept 77 MSME listings and the boundary maps current, on a scheduled
            backup.
          </li>
        </ul>

        <Compare
          before={apbdesBefore}
          after={apbdesAfter}
          beforeAlt="The village budget page before the rebuild: three columns
            of plain tables listing budget and realisation figures for revenue,
            spending, and financing."
          afterAlt="The same page after the rebuild: a single donut chart
            showing total budget with three labelled segments and their amounts
            listed beside it."
          beforeLabel="Before"
          afterLabel="After"
          caption="Drag the handle. Three tables of raw figures on the left, one
            donut chart of budget against realisation on the right. The village
            head asked for proportion at a glance."
        />

        {/* Harus tetap di dalam .post__body. Sebagai anak langsung .post
            ia jadi item grid ketiga dan mendarat di kolom kiri, menimpa
            pelat spesifikasi yang menempel di sana. */}
        <div class="pair rise-group">
          <figure class="shot">
            <Image
              src={villageFinance}
              alt="Standing with a member of village staff in the Pulau Gadang
                integrated service office, under the office's name board."
              widths={[520, 1000]}
              sizes="(min-width: 46rem) 45vw, 92vw"
              format="webp"
              quality={70}
              loading="lazy"
            />
            <figcaption class="caption">
              Checking figures at the village office before writing any code.
            </figcaption>
          </figure>

          <figure class="shot">
            <Image
              src={villagePresentation}
              alt="Presenting the rebuilt village website in the village meeting
                room, with the site projected on screen."
              widths={[520, 1000]}
              sizes="(min-width: 46rem) 45vw, 92vw"
              format="webp"
              quality={70}
              loading="lazy"
            />
            <figcaption class="caption">
              Presenting the result to village staff, 28 May 2025.
            </figcaption>
          </figure>
        </div>
      </div>
    </article>
  </div>
</section>

<style>
  .post {
    display: grid;
    gap: 2rem;
    margin-top: 3rem;
  }

  .post + .post {
    margin-top: 3.5rem;
    padding-top: 3.5rem;
    border-top: 1px solid var(--rule);
  }

  @media (min-width: 58rem) {
    .post {
      grid-template-columns: 16rem minmax(0, 1fr);
      gap: 3.5rem;
      align-items: start;
    }

    /* Kolom kiri menggantung selama bullet di kanan digulir, jadi angka
       jabatan tetap terbaca saat membaca rinciannya. */
    .post__meta {
      position: sticky;
      top: 5rem;
    }
  }

  .post__role {
    font-size: var(--size-subhead);
    line-height: 1.25;
  }

  .post__org {
    margin-top: 0.45rem;
    color: var(--ink-soft);
  }

  .post__when {
    margin-top: 0.15rem;
    color: var(--ink-soft);
  }

  /* Lajur angka jabatan. Dibaca seperti pelat spesifikasi, bukan kartu. */
  .spec {
    margin: 1.5rem 0 0;
    border-top: 1px solid var(--rule);
  }

  .spec > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .spec dt {
    font-size: var(--size-caption);
    color: var(--ink-soft);
  }

  .spec dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  .post__points {
    margin: 0;
    padding-left: 1.1rem;
    max-width: var(--measure);
  }

  .post__points li + li {
    margin-top: 0.75rem;
  }

  .post__points li::marker {
    color: var(--ink-soft);
  }

  /* Sisanya diwarisi .shot di global.css. */
  .shot {
    margin-top: 2rem;
  }

  .pair {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.75rem;
  }

  @media (min-width: 46rem) {
    .pair {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
  }

  .pair .shot {
    margin-top: 0;
  }
</style>
