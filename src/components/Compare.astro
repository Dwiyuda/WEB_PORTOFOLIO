---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  beforeAlt: string;
  afterAlt: string;
  beforeLabel: string;
  afterLabel: string;
  caption: string;
}

const { before, after, beforeAlt, afterAlt, beforeLabel, afterLabel, caption } =
  Astro.props;

// Penggeser sebelum-sesudah. Kendalinya <input type="range"> sungguhan, jadi
// panah kiri-kanan pada papan ketik bekerja tanpa kode tambahan dan pembaca
// layar mengumumkannya sebagai penggeser.
---

<figure class="cmp">
  <div class="cmp__frame" style="--pos:50%">
    <Image
      class="cmp__img"
      src={after}
      alt={afterAlt}
      widths={[720, 1200]}
      sizes="(min-width: 46rem) 60vw, 92vw"
      format="webp"
      loading="lazy"
    />

    <div class="cmp__clip">
      <Image
        class="cmp__img"
        src={before}
        alt={beforeAlt}
        widths={[720, 1200]}
        sizes="(min-width: 46rem) 60vw, 92vw"
        format="webp"
        loading="lazy"
      />
    </div>

    <span class="cmp__tag cmp__tag--l figure">{beforeLabel}</span>
    <span class="cmp__tag cmp__tag--r figure">{afterLabel}</span>

    <span class="cmp__bar" aria-hidden="true">
      <span class="cmp__grip">
        <svg width="14" height="10" viewBox="0 0 14 10" aria-hidden="true">
          <path
            d="M5 1 1.5 5 5 9M9 1l3.5 4L9 9"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>
    </span>

    <input
      class="cmp__range"
      type="range"
      min="0"
      max="100"
      value="50"
      step="0.1"
      aria-label={`Reveal ${beforeLabel} against ${afterLabel}`}
    />
  </div>

  <figcaption class="caption">{caption}</figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>(".cmp__frame").forEach((frame) => {
    const range = frame.querySelector<HTMLInputElement>(".cmp__range");
    if (!range) return;
    const paint = () => frame.style.setProperty("--pos", `${range.value}%`);
    range.addEventListener("input", paint);
    paint();
  });
</script>

<style>
  .cmp {
    margin: 2rem 0 0;
    max-width: 44rem;
  }

  .cmp__frame {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 2px;
    line-height: 0;
    touch-action: pan-y;
  }

  .cmp__img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Lapisan "sebelum" dipotong sampai posisi penggeser. */
  .cmp__clip {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }

  .cmp__clip .cmp__img {
    height: 100%;
    object-fit: cover;
  }

  .cmp__tag {
    position: absolute;
    top: 0.6rem;
    padding: 0.2rem 0.5rem;
    font-size: 0.7rem;
    line-height: 1.4;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--paper);
    background: color-mix(in srgb, #14181c 78%, transparent);
    border-radius: 2px;
    backdrop-filter: blur(4px);
    pointer-events: none;
  }

  .cmp__tag--l {
    left: 0.6rem;
  }
  .cmp__tag--r {
    right: 0.6rem;
  }

  .cmp__bar {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    margin-left: -1px;
    background: var(--paper);
    box-shadow: 0 0 0 1px color-mix(in srgb, #14181c 25%, transparent);
    pointer-events: none;
  }

  .cmp__grip {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    color: #14181c;
    background: var(--paper);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    box-shadow: 0 1px 6px rgb(0 0 0 / 0.28);
    transition: transform var(--t-mid) var(--ease-out);
  }

  .cmp__frame:hover .cmp__grip {
    transform: translate(-50%, -50%) scale(1.12);
  }

  /* Penggeser asli dibentangkan menutupi gambar dan dibuat tak terlihat.
     Fungsinya tetap penuh, tampilannya diambil alih .cmp__bar. */
  .cmp__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    appearance: none;
    background: transparent;
  }

  .cmp__range::-webkit-slider-thumb {
    appearance: none;
    width: 3rem;
    height: 100%;
  }

  .cmp__range::-moz-range-thumb {
    width: 3rem;
    height: 100%;
    border: 0;
    background: transparent;
  }

  .cmp__range:focus-visible {
    outline: none;
  }

  .cmp__frame:has(.cmp__range:focus-visible) {
    outline: 2px solid var(--verified);
    outline-offset: 3px;
  }

  .cmp figcaption {
    margin-top: 0.65rem;
    line-height: 1.55;
  }
</style>
