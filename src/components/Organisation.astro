---
import { Image } from "astro:assets";
import handover from "../assets/village-handover.jpeg";
import goesToSchool from "../assets/goes-to-school.jpg";
import inductionCamp from "../assets/induction-camp.jpg";

// Bagian 6. Sumber: Riwayat Pengalaman Dwi Yuda.
//
// Bagian ini kekuatannya angka orang, bukan daftar tugas, jadi bentuknya
// lajur: angka memimpin, keterangan mengikuti. Berbeda dari kolom menempel
// di Pengalaman dan dari kisi bento di Pencapaian.
//
// Website HIMATIF ditulis "Directed", tidak pernah "Built". Catatan di bawah
// lajur menyebutkan alasannya terang-terangan. Jangan dihapus.
const ledgerN = ["7", "280", "50"];

const lang = Astro.currentLocale === "en" ? "en" : "id";
const t = {
  id: {
    label: "Organisasi dan pengabdian",
    heading: "Menjalankan hal yang tidak saya bangun",
    viceRole: "Wakil Ketua, HIMATIF",
    viceWhen: "Himpunan Mahasiswa Teknik Informatika, UIR · Feb 2024 – Apr 2025",
    ledger: [
      "Divisi operasional diawasi, dengan 50 anggota di bawahnya, bertanggung jawab kepada ketua.",
      "Peserta di kemah pengaderan mahasiswa, dikoordinasikan bersama panitia 100 orang.",
      "Siswa SMK di seminar TI dan keamanan siber di SMK Labor, dibawakan bersama dua belas relawan.",
    ],
    disclaim:
      "Judul itu harfiah. Situs profil Next.js himpunan dibangun oleh divisi Riset dan Teknologi, bukan oleh saya. Saya menetapkan lingkupnya dan mereview apa yang kembali. Kodenya milik mereka, dan itulah sebabnya semua di sini berbunyi diarahkan, bukan dibangun.",
    goesToSchoolAlt:
      "Sebuah aula di SMK Labor di penghujung seminar. Sekitar lima puluh siswa SMK dan tim relawan berdiri di belakang spanduk bertuliskan HIMATIF Go To School.",
    goesToSchoolCap: "Go To School di SMK Labor. Foto dipakai dengan izin.",
    campAlt:
      "Kemah pengaderan mahasiswa, dengan peserta berkumpul di lapangan terbuka.",
    campCap: "Kemah pengaderan: 280 peserta, 100 di kepanitiaan.",
    memberRole: "Anggota tim mahasiswa, Desa Binaan",
    memberWhen: "Pulau Gadang, Kampar · Okt 2024 – Mar 2025",
    service: [
      "Program pemberdayaan masyarakat yang dijalankan tim mahasiswa UIR. Pra-survei turun pada 25 Oktober 2024, dan sesi-sesi yang menyusul diadakan di balai desa bersama kepala desa dan seluruh perangkatnya, tentang hukum desa dan tentang mempublikasikan catatan anggaran.",
      "Programnya ditulis dan dipublikasikan setelahnya. Ia artikel di bagian berikutnya.",
    ],
    handoverAlt:
      "Serah terima di ruang pertemuan desa. Seorang anggota tim mahasiswa menyerahkan laptop yang menampilkan situs baru kepada kepala desa, dengan empat orang lain berdiri di samping.",
    handoverCap:
      "Menyerahkan situs yang selesai kepada kepala desa. Foto dipakai dengan izin.",
  },
  en: {
    label: "Organisation and service",
    heading: "Running things I did not build",
    viceRole: "Vice Chairman, HIMATIF",
    viceWhen: "Informatics Student Association, UIR · Feb 2024 – Apr 2025",
    ledger: [
      "Operational divisions supervised, with 50 members under them, reporting to the chair.",
      "Participants at the student induction camp, coordinated against a committee of 100.",
      "Vocational students at an IT and cyber security seminar at SMK Labor, delivered with twelve volunteers.",
    ],
    disclaim:
      "That heading is literal. The association's Next.js profile site was built by the Research and Technology division, not by me. I set the scope and reviewed what came back. The code is theirs, which is why everything here says directed rather than built.",
    goesToSchoolAlt:
      "A hall at SMK Labor at the end of the seminar. Around fifty vocational students and the volunteer team stand behind a banner reading HIMATIF Go To School.",
    goesToSchoolCap: "Go To School at SMK Labor. Photograph used with permission.",
    campAlt: "The student induction camp, with participants gathered in an open field.",
    campCap: "The induction camp: 280 participants, 100 on the committee.",
    memberRole: "Student team member, Desa Binaan",
    memberWhen: "Pulau Gadang, Kampar · Oct 2024 – Mar 2025",
    service: [
      "A community empowerment programme run by a UIR student team. The pre-survey went out on 25 October 2024, and the sessions that followed were held at the village hall with the village head and every member of staff, on village law and on publishing budget records.",
      "The programme was written up afterwards and published. It is the article in the next section.",
    ],
    handoverAlt:
      "Handover in the village meeting room. A student team member passes a laptop showing the new site to the village head, with four others standing alongside.",
    handoverCap:
      "Handing the finished site to the village head. Photograph used with permission.",
  },
}[lang];
---

<section class="section" id="organisation" aria-labelledby="organisation-title">
  <div class="shell">
    <span class="section__label">{t.label}</span>
    <h2 id="organisation-title" class="rise">{t.heading}</h2>

    <div class="lede rise">
      <h3>{t.viceRole}</h3>
      <p class="figure lede__when">
        {t.viceWhen}
      </p>
    </div>

    <dl class="ledger rise-group">
      {
        ledgerN.map((n, i) => (
          <div class="ledger__row">
            <dt class="ledger__n">{n}</dt>
            <dd class="ledger__text">{t.ledger[i]}</dd>
          </div>
        ))
      }
    </dl>

    {/* Duduk tepat setelah lajur, bukan setelah galeri. Judul bagian ini
        baru masuk akal begitu paragraf ini terbaca, jadi jaraknya harus
        sedekat mungkin. */}
    <p class="disclaim rise">{t.disclaim}</p>

    <div class="gallery rise-group">
      <figure class="shot">
        <Image
          src={goesToSchool}
          alt={t.goesToSchoolAlt}
          widths={[560, 900]}
          sizes="(min-width: 46rem) 45vw, 92vw"
          format="webp"
          quality={64}
          loading="lazy"
        />
        <figcaption class="caption">{t.goesToSchoolCap}</figcaption>
      </figure>

      <figure class="shot">
        <Image
          src={inductionCamp}
          alt={t.campAlt}
          widths={[560, 900]}
          sizes="(min-width: 46rem) 45vw, 92vw"
          format="webp"
          quality={64}
          loading="lazy"
        />
        <figcaption class="caption">{t.campCap}</figcaption>
      </figure>
    </div>

    <div class="lede lede--second rise">
      <h3>{t.memberRole}</h3>
      <p class="figure lede__when">{t.memberWhen}</p>
    </div>

    <div class="service rise">
      <div class="service__text">
        {t.service.map((para) => <p>{para}</p>)}
      </div>

      <figure class="shot">
        <Image
          src={handover}
          alt={t.handoverAlt}
          widths={[560, 900]}
          sizes="(min-width: 50rem) 42vw, 92vw"
          format="webp"
          quality={62}
          loading="lazy"
        />
        <figcaption class="caption">{t.handoverCap}</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .lede {
    margin-top: 2.75rem;
  }

  .lede--second {
    margin-top: 3.5rem;
    padding-top: 3.5rem;
    border-top: 1px solid var(--rule);
  }

  .lede h3 {
    font-size: var(--size-subhead);
  }

  .lede__when {
    margin-top: 0.4rem;
    color: var(--ink-soft);
  }

  /* Lajur: angka memimpin baris, keterangan menyusul. */
  .ledger {
    margin: 1.75rem 0 0;
    border-top: 1px solid var(--rule);
  }

  .ledger__row {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    align-items: baseline;
    gap: 1.25rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--rule);
    transition: padding-left var(--t-mid) var(--ease-out);
  }

  .ledger__row:hover {
    padding-left: 0.5rem;
  }

  .ledger__n {
    font-family: var(--font-mono);
    font-size: clamp(1.75rem, 1.4rem + 1.6vw, 2.5rem);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--ink);
  }

  .ledger__text {
    margin: 0;
    max-width: var(--measure);
    color: var(--ink-soft);
  }

  @media (max-width: 34rem) {
    .ledger__row {
      grid-template-columns: 4rem minmax(0, 1fr);
      gap: 1rem;
    }
  }

  .gallery {
    display: grid;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  @media (min-width: 46rem) {
    .gallery {
      grid-template-columns: 1fr 1fr;
      gap: 1.75rem;
    }
  }

  /* Catatan integritas. Bukan kartu, hanya teks bertakik, supaya terbaca
     sebagai koreksi penulis atas dirinya sendiri. */
  .disclaim {
    max-width: var(--measure);
    margin-top: 1.5rem;
    padding-left: 1.25rem;
    border-left: 1px solid var(--ink-soft);
    font-size: var(--size-figure);
    line-height: 1.65;
    color: var(--ink-soft);
  }

  .service {
    display: grid;
    gap: 2rem;
    margin-top: 2rem;
  }

  @media (min-width: 50rem) {
    .service {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 2.5rem;
      align-items: start;
    }
  }

  .service__text p + p {
    margin-top: 1.1rem;
  }
</style>
