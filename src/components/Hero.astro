---
import { Image } from "astro:assets";
import portrait from "../assets/portrait.jpg";

// Bagian 1. Angka dari Riwayat Pengalaman dan hasil eksperimen skripsi.
//
// IPK dan jumlah SKS sengaja tidak ditayangkan, atas keputusan pemilik situs
// 18 Agustus 2026. Jangan menambahkannya kembali tanpa keputusan baru.
//
// Chip ketiga dulu "4 tahun tanpa mengulang", satu-satunya sisa klaim rekam
// akademik di hero yang isinya kini soal pekerjaan. Diganti data diri.
//
// Arabic ditulis "conversational" dengan sengaja. Bagian Tentang saya
// menyatakan "I can still hold a conversation in it, though I would not claim
// more than that", jadi menulis "3 languages" tanpa kualifikasi akan melebihi
// yang bisa dipertahankan saat wawancara. Kualifikasi di label justru
// menguatkan, logika yang sama dengan "Author 7 of 11" di bagian Publikasi.
//
// Data diri yang TIDAK boleh naik ke sini: tanggal lahir lengkap, alamat, dan
// nomor telepon. Alasannya ada di About.astro dan di PRD.
const figures = [
  { value: "1,645", unit: "images", label: "Thesis dataset" },
  { value: "~300", unit: "undergraduates", label: "Taught, 4 semesters" },
  {
    value: "3",
    unit: "languages",
    label: "Indonesian, English, conversational Arabic",
  },
];
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="shell shell--wide">
    {/* Nama naik dari balik garis potong. Satu-satunya gerak yang jalan
        saat muat, sisanya digerakkan gulir. */}
    <h1 class="hero__name" id="hero-title">
      <span class="mask"><span class="mask__in">Dwi</span></span>
      <span class="mask"><span class="mask__in mask__in--late">Yuda</span></span>
    </h1>

    <div class="hero__body">
      <div class="hero__text">
        <p class="hero__claim">
          I audit my own work before someone else has to.
        </p>
        <p class="hero__meta">
          Informatics graduate from Universitas Islam Riau, Pekanbaru. I work on
          computer vision, LLM applications, and the evaluation that decides
          whether either one is telling the truth.
        </p>
        {/* Tombol CV kembali sejak berkasnya diekspor ulang tanpa nomor
            telepon. Kalau CV diganti, periksa lagi baris kontaknya dulu. */}
        <p class="hero__actions">
          <a class="button" href="mailto:dwiiyudaaa@gmail.com">
            dwiiyudaaa@gmail.com
          </a>
          {/* Tanpa `download`: atribut itulah yang dulu memaksa berkas terunduh
              alih-alih tampil. Sekarang CV dibuka di viewer PDF peramban, dan
              di tab baru supaya pembaca tidak kehilangan tempatnya di halaman. */}
          <a
            class="hero__link"
            href="/dwi-yuda-cv.pdf"
            target="_blank"
            rel="noopener"
          >
            CV (PDF)
          </a>
          <a class="hero__link" href="https://www.linkedin.com/in/dwiyuda">
            LinkedIn
          </a>
          <a class="hero__link" href="https://github.com/Dwiyuda">GitHub</a>
        </p>
      </div>

      <figure class="hero__portrait">
        <Image
          src={portrait}
          alt="Dwi Yuda in a dark suit, wearing a maroon graduation stole
            reading Bachelor of Informatics Engineering, Class of 2026, in
            front of a Pekanbaru sign."
          widths={[360, 467]}
          sizes="(min-width: 52rem) 14rem, 60vw"
          format="webp"
          quality={80}
          loading="eager"
        />
        <figcaption class="caption">Pekanbaru, July 2026.</figcaption>
      </figure>
    </div>

    <dl class="hero__figures rise-figures">
      {
        figures.map((f) => (
          <div class="hero__figure">
            <dt class="caption">{f.label}</dt>
            <dd>
              <span class="hero__value">{f.value}</span>
              <span class="figure hero__unit">{f.unit}</span>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>

  <span class="hero__hint caption" aria-hidden="true">scroll</span>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(2.5rem, 7vw, 5rem) var(--section-gap);
  }

  .hero__name {
    font-size: clamp(3.25rem, 13vw, 9rem);
    line-height: 0.86;
    letter-spacing: -0.045em;
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.28em;
  }

  .mask {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }

  .mask__in {
    display: block;
    animation: mask-up 900ms var(--ease-out) both;
  }

  .mask__in--late {
    animation-delay: 110ms;
  }

  @keyframes mask-up {
    from {
      transform: translateY(105%);
    }
    to {
      transform: none;
    }
  }

  .hero__body {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    margin-top: clamp(2rem, 5vw, 3.25rem);
    padding-top: clamp(1.75rem, 4vw, 2.5rem);
    border-top: 1px solid var(--rule);
  }

  @media (min-width: 52rem) {
    .hero__body {
      grid-template-columns: minmax(0, 1fr) 14rem;
      align-items: start;
    }
  }

  .hero__claim {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.15rem + 1.6vw, 2.1rem);
    font-weight: 400;
    line-height: 1.3;
    max-width: 22ch;
    text-wrap: balance;
  }

  .hero__meta {
    max-width: var(--measure);
    margin-top: 1.1rem;
    color: var(--ink-soft);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 1.9rem;
  }

  .button {
    position: relative;
    display: inline-block;
    padding: 0.65rem 1.15rem;
    font-family: var(--font-mono);
    font-size: var(--size-figure);
    text-decoration: none;
    color: var(--paper);
    background: var(--ink);
    border-radius: 2px;
    overflow: hidden;
    transition: transform var(--t-mid) var(--ease-out);
  }

  .button:hover {
    transform: translateY(-2px);
  }

  /* Kilau tipis yang menyapu tombol saat disentuh kursor. */
  .button::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      transparent 30%,
      color-mix(in srgb, var(--paper) 28%, transparent) 50%,
      transparent 70%
    );
    transform: translateX(-100%);
    transition: transform 620ms var(--ease-out);
  }

  .button:hover::after {
    transform: translateX(100%);
  }

  .hero__link {
    font-family: var(--font-mono);
    font-size: var(--size-figure);
    color: var(--ink-soft);
    text-decoration: none;
    transition: color var(--t-fast) var(--ease-out);
  }

  .hero__link:hover {
    color: var(--ink);
  }

  .hero__portrait {
    margin: 0;
  }

  /* Tanpa bingkai dan tanpa bayangan. Fotonya berdiri sendiri di atas
     kertas; sudut dibulatkan sedikit saja supaya tepinya tidak setajam
     tangkapan layar di bagian lain halaman. */
  .hero__portrait img {
    width: 100%;
    max-width: 14rem;
    border-radius: 3px;
  }

  .hero__portrait figcaption {
    max-width: 14rem;
    margin-top: 0.85rem;
  }

  .hero__figures {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
    gap: 1.5rem 2rem;
    margin: clamp(2.5rem, 6vw, 4rem) 0 0;
    padding-top: 1.75rem;
    border-top: 1px solid var(--rule);
  }

  .hero__figure dd {
    margin: 0.15rem 0 0;
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
  }

  .hero__value {
    font-family: var(--font-mono);
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.035em;
  }

  .hero__unit {
    color: var(--ink-soft);
  }

  .hero__hint {
    position: absolute;
    right: var(--gutter);
    bottom: 1.5rem;
    font-family: var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
    /* Satu-satunya pemakai --ease yang tersisa, dan sengaja. Ini denyut
       menganggur yang bolak-balik, bukan tanggapan atas klik. --ease-out
       (0.16, 1, 0.3, 1) menaruh hampir seluruh gerak di awal tiap segmen, jadi
       denyutnya terbaca sebagai sentakan lalu diam. Kurva --ease yang lebih
       simetris itulah yang membuatnya bernapas. */
    animation: hint 2.6s var(--ease) infinite;
  }

  @keyframes hint {
    0%,
    100% {
      opacity: 0.35;
      transform: none;
    }
    50% {
      opacity: 1;
      transform: translateY(4px);
    }
  }

  @media (max-width: 52rem) {
    .hero__hint {
      display: none;
    }
  }
</style>
