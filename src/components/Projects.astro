// Kisi ringkas. Tanpa label konteks, atas keputusan pemilik situs; tiap kartu
// menyebut masalahnya, apa yang dibangun, angka, stack, dan tautan repo.
// Kalau sebuah angka menyesatkan tanpa penjelasan, penjelasannya ikut di
// kartu (housing: R² tinggi karena target diturunkan dari rumus SK; village:
// bobot AHP masih templat).
const gh = (repo: string) => `https://github.com/Dwiyuda/${repo}`;

type BriefItem = {
  title: string;
  text: string;
  chips: [string, string][];
  stack: string;
  repo: string;
  demo?: { href: string; label: string };
};

const briefId: { heading: string; items: BriefItem[] }[] = [
  {
    heading: "AI dan machine learning",
    items: [
      {
        title: "Deteksi penyakit tanaman dengan penjelasan Graph RAG",
        text: "Sebuah foto daun mendapat diagnosis dan penjelasan apa yang harus dilakukan, dalam bahasa Indonesia. Saya mem-fine-tune ResNet-50 pada dua belas penyakit di empat komoditas, ditambah kelas unknown eksplisit agar ia bisa menolak, dan membangun lapisan Graph RAG di atas knowledge graph Neo4j agar sarannya datang dari fakta terkurasi, bukan ingatan model. Dievaluasi dengan RAGAS pada golden set 60 pertanyaan.",
        chips: [
          ["0,9786", "akurasi uji"],
          ["0,9554", "faithfulness RAGAS"],
          ["0,9725", "context recall"],
        ],
        stack: "PyTorch, Neo4j, sentence-transformers, Groq, RAGAS, Gradio",
        repo: gh("plant-disease-cnn-graph-rag"),
      },
      {
        title: "Deteksi penyakit daun terong",
        text: "Dataset publiknya memberi satu label per foto. Saya membangunnya ulang untuk deteksi, jadi model menunjukkan di mana gejalanya: pelabelan otomatis, audit tingkat-kotak dengan antrean tinjauan berprioritas, koreksi terkalibrasi, lalu pelatihan ulang. Auditnya juga mengukur langit-langitnya: 46% kotak otomatis keliru dan 56% bercak nyata terlewat, itulah sebabnya angka di bawah ini sederhana dan tetap saya laporkan.",
        chips: [
          ["0,8037", "macro-F1 per daun"],
          ["166 / 208", "daun benar"],
          ["0,6736", "mAP@0.5"],
        ],
        stack: "YOLO11 (Ultralytics), OpenCV, SAHI, Flask",
