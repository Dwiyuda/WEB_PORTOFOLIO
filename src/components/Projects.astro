---
import { Image } from "astro:assets";
import AuditDiagram from "./AuditDiagram.astro";
import Pipeline from "./Pipeline.astro";
import shotAccepted from "../assets/detector-accepted.jpg";
import shotRejected from "../assets/detector-rejected.jpg";
import shotGradcam from "../assets/detector-gradcam.jpg";

// Tangkapan layar sudah melewati scripts/prep-screens.mjs. Setiap kartu
// identitas di dalamnya diburamkan sampai tidak terbaca, karena kartu itu
// milik orang lain. Jangan pernah memasang tangkapan mentah dari assets/.
//
// Keluaran LLM Grading tidak ditampilkan sebagai data. Berkas Excel-nya
// memuat nama, alamat surel, dan nilai mahasiswa. Yang ditayangkan hanya
// susunan kolomnya.
const sheets = [
  { name: "Rekap", cols: "NIM, name, status, total, confidence, needs review" },
  { name: "Detail", cols: "NIM, name, criterion, score, feedback" },
  { name: "Flag", cols: "NIM, name, status, reason for review" },
];

// Bagian 5. Dua tingkat sejak 21 Oktober 2026: tiga proyek unggulan dengan
// kartu penuh, lalu kisi ringkas yang dikelompokkan per fokus, AI paling atas.
// Hening dan pelacak pembayaran angkatan dibuang atas keputusan pemilik situs.
//
// Sumber angka KTM: HASIL_UJICOBA_TAMBAHAN/README.md (25 Juli 2026) dan
// metrics_summary.json tiap folder hasil, sudah dicocokkan satu per satu.
// Sumber asisten hukum: README + eval/results/*.md repo publiknya, dan log CI
// (395 passed, 1 skipped). Bukan 406: itu hitungan venv lokal yang tidak bisa
// dicek pembaca.
// Sumber grader: SISTEM_ASISTENSI_A/KELANJUTAN.md (20 Okt 2026) dan README
// repo publik llm-practicum-grader.
// Sumber kisi ringkas: README dan berkas hasil tiap repo publik (21 Okt 2026).
//
// PENTING soal narasi KTM. Model final yang dilaporkan = EfficientNet-B0 pada
// resolusi native 224×224, 97,74% / ROC-AUC 0,9912. Versi 1024×474 dengan
// 1,0000 adalah versi awal yang ditinggalkan, BUKAN model produksi. Perbaikan
// kebocoran 29% TIDAK menurunkan akurasi; yang menurunkannya ke 0,9606-0,9774
// adalah pindah ke resolusi native. Jangan pernah menyandingkan 29% dengan
// 97,7% seolah yang satu menyebabkan yang lain.
//
// Bentuk tiap proyek unggulan: abstrak terbuka, kedalaman di balik <details>.
const pipeline = [
  {
    stage: "Qwen3-VL",
    role: "Semantic gate. Rejects anything that is not an ID card, zero-shot.",
    detail:
      "It has to throw out a photo of a desk, a hand, a blank wall, before any of that reaches the classifier. Evaluated separately with an LLM-as-a-judge pass over card and non-card images, where it scored perfectly.",
  },
  {
    stage: "Florence-2 + Canny",
    role: "Phrase grounding locates the card, then edge detection crops and deskews it.",
    detail:
      "Florence-2 says where the card is, Canny finds its edges, and the crop straightens it. The classifier never sees the desk it was lying on, so background stops being a feature it can cheat with.",
  },
  {
    stage: "EfficientNet-B0",
    role: "Binary classifier, genuine against forged.",
    detail:
      "Two-phase transfer learning from ImageNet: the head trains first with the backbone frozen, then the whole network fine-tunes. Mixup at alpha 0.4, AdamW, seed 42. The reported model runs at its native 224×224 input and fits in 4 GB of VRAM.",
  },
  {
    stage: "Grad-CAM",
    role: "Heatmap over the region that drove the decision.",
    detail:
      "This is the part that keeps the rest honest. On a font forgery the heat sits on the text block; on a face swap it sits on the portrait. If it had lit up the background instead, the accuracy figure would have meant nothing.",
  },
];

// Asisten hukum keluarga Islam. Setiap angka evaluasi yang optimistis ditulis
// beserta alasannya, sesuai bagian "Honest caveats" di README repo-nya.
const lawPipeline = [
  {
    stage: "BM25 + BGE-M3",
    role: "Hybrid retrieval: keyword and dense search, fused with reciprocal rank fusion.",
    detail:
      "On 80 in-domain questions the full stack reaches Recall@5 0.601 and MRR@10 0.702. The fusion on its own is not what earns that: it scored 0.428, below dense search alone at 0.575, and BM25 alone managed 0.223. The reranker in the next step is what lifts it past both.",
  },
  {
    stage: "Reranker gate",
    role: "bge-reranker-v2-m3 reorders the results, and a low score means refuse.",
    detail:
      "The refusal happens before any language model is called, so an off-topic question costs nothing and cannot be answered from thin air. It refused 95.0% of out-of-domain questions while wrongly refusing 1.2% of real ones. Those thresholds were fitted on the same questions they are scored on, so read the figures as optimistic. On the held-out set the gate alone catches 0.650, and the generation stage brings refusal to 1.000.",
  },
  {
    stage: "Grounded answer",
    role: "The model may only cite retrieved passages, and its output is validated against a schema.",
    detail:
      "Citation precision is 1.000 across every question group. RAGAS faithfulness is 0.827 on 69 samples, below the 0.85 I was aiming for, from a run cut short when the free-tier judge quota ran out. The judge is the same model family as the generator, so that number is generous too.",
  },
  {
    stage: "Faraid engine",
    role: "Inheritance shares in exact fractions, computed by rules, never by the model.",
    detail:
      "It implements Book II of the Compilation of Islamic Law, articles 171 to 193, and checks against 104 textbook cases. Grandparents and substitute heirs need interpretation beyond the literal text, so those results are flagged for review by a qualified fiqh scholar instead of being presented as final.",
  },
];

// Grader praktikum. Data mahasiswa asli tidak pernah tampil; repo publiknya
// adalah snapshot bersih dengan contoh sintetis.
const graderPipeline = [
  {
    stage: "Key maker",
    role: "Drafts the answer key and a weighted rubric from the question.",
    detail:
      "Gemini drafts once per session. The draft stays pending until the lecturer approves it, and the grader refuses to run on a key nobody has approved.",
  },
  {
    stage: "Classroom fetch",
    role: "Pulls every submission and its official status, with read-only access.",
    detail:
      "Deadlines come from Classroom's structured fields, not from the wording of the question. Google Docs and Slides are exported to PDF. A late submission is not graded but still appears in the recap, so there is a record if anyone disputes a mark.",
  },
  {
    stage: "Grader",
    role: "One submission per request, structured output, resumable.",
    detail:
      "PDFs go to the model natively, notebooks as Markdown, Word files through LibreOffice. Code is read, never executed: if the model cannot tell whether it would run, it must say so with low confidence. The model fills only the scoring fields. Identity and status are set by code, so it cannot invent them.",
  },
  {
    stage: "Recap",
    role: "An Excel workbook with three sheets and a confidence gate.",
    detail:
      "Only high-confidence results with no file problems become final on their own. Everything else lands in the Flag sheet with its reason, for a person to check.",
  },
];

// Kisi ringkas. Tanpa label konteks, atas keputusan pemilik situs; tiap kartu
// menyebut masalahnya, apa yang dibangun, angka, stack, dan tautan repo.
// Kalau sebuah angka menyesatkan tanpa penjelasan, penjelasannya ikut di
// kartu (housing: R² tinggi karena target diturunkan dari rumus SK; village:
// bobot AHP masih templat).
const gh = (repo: string) => `https://github.com/Dwiyuda/${repo}`;

const brief = [
  {
    heading: "AI and machine learning",
    items: [
      {
        title: "Plant disease detection with Graph RAG explanations",
        text: "A leaf photo gets a diagnosis and an explanation of what to do about it, in Indonesian. I fine-tuned a ResNet-50 on twelve diseases across four crops, plus an explicit unknown class so it can decline, and built a Graph RAG layer over a Neo4j knowledge graph so the advice comes from curated facts rather than the model's memory. Evaluated with RAGAS on a 60-question golden set.",
        chips: [
          ["0.9786", "test accuracy"],
          ["0.9554", "RAGAS faithfulness"],
          ["0.9725", "context recall"],
        ],
        stack: "PyTorch, Neo4j, sentence-transformers, Groq, RAGAS, Gradio",
        repo: gh("plant-disease-cnn-graph-rag"),
      },
      {
        title: "Eggplant leaf disease detection",
        text: "The public dataset gave one label per photo. I rebuilt it for detection, so the model shows where the symptoms are: auto-labelling, a box-level audit with a prioritised review queue, calibrated corrections, then retraining. The audit also measured the ceiling: 46% of the automatic boxes were false and 56% of real lesions were missed, which is why the numbers below are modest and why I report them anyway.",
        chips: [
          ["0.8037", "macro-F1 per leaf"],
          ["166 / 208", "leaves correct"],
          ["0.6736", "mAP@0.5"],
        ],
        stack: "YOLO11 (Ultralytics), OpenCV, SAHI, Flask",
        repo: gh("eggplant-leaf-disease-detection-yolov11"),
      },
      {
        title: "Shallot disease diagnosis with zero-shot vision models",
        text: "Can a vision-language model diagnose shallot leaf disease with no training at all? I ran a controlled experiment: five prompt designs, four models, a 30-image split for choosing prompts and 80 held-out images for the result. The finding worth keeping is how unevenly prompt design matters: it moved accuracy by 5 points for Gemini and Llama 4, and by 16 to 19 points for both Qwen models. With 80 test images each 95% confidence interval spans 17 to 20 points, so only one of six model pairs differs significantly.",
        chips: [
          ["82.5%", "best accuracy"],
          ["p = 0.0452", "McNemar, Holm"],
          ["4 × 5", "models × prompts"],
        ],
        stack: "OpenRouter, Gemini, Qwen3-VL, Llama 4, Python",
        repo: gh("shallot-disease-lvlm-zero-shot"),
      },
    ],
  },
  {
    heading: "Data and decision support",
    items: [
      {
        title: "Village priority for social assistance",
        text: "Aid is decided in village meetings, but the data only existed per household or per regency. I aggregated a regency's socio-economic registry to village level, clustered villages by poverty profile with K-Means, and ranked them with AHP and TOPSIS, cross-checked against SAW. The Flask app has 21 pairwise sliders and refuses to save weights once the consistency ratio passes 0.10. The weights it ships with are a template awaiting the social affairs office, so the ratio describes that template, not an expert panel.",
        chips: [
          ["371", "villages"],
          ["~142,800", "households"],
          ["0.0100", "consistency ratio"],
        ],
        stack: "scikit-learn, pandas, SciPy, Flask, fpdf2",
        repo: gh("village-aid-priority-kmeans-ahp-topsis"),
      },
      {
        title: "Housing renovation aid priority",
        text: "A city housing agency decides who gets renovation aid from fifteen observations of each house. Eligibility is written in a mayoral decree, so I computed it as rules rather than learning it, and XGBoost only ranks eligible houses by urgency. A zone clamp guarantees an ineligible house can never outrank an eligible one. The urgency target is derived from the decree's weighting formula, so the model's R² of 0.9989 says it reproduces that formula, not that it predicts something independent.",
        chips: [
          ["2", "layers, rules then model"],
          ["3", "priority tiers"],
          ["1,196", "houses"],
        ],
        stack: "XGBoost, scikit-learn, Streamlit, SQLite, ReportLab",
        repo: gh("housing-aid-priority-xgboost"),
      },
    ],
  },
  {
    heading: "Web",
    items: [
      {
        title: "Website for a Mandarin course agency",
        text: "A bilingual site in Indonesian and Chinese for an agency that teaches Mandarin and sends students to study in China, with a Git-based CMS so staff can change content without touching code. Static Astro output on Cloudflare Pages. The public repository is a showcase copy: contacts, prices, alumni and photos are replaced with sample data.",
        chips: [
          ["2", "languages"],
          ["67", "components"],
          ["11", "content collections"],
        ],
        stack: "Astro, TypeScript, Sveltia CMS, Cloudflare Pages",
        repo: gh("website_easternllcedu"),
      },
    ],
  },
];
---

{/* data-no-drift: AuditDiagram di bawah memasang view-transition-name pada 18
    chip. Transform di leluhur menjadikan bagian ini stacking context sekaligus
    containing block untuk semuanya — beban yang sama yang membuat aturan sticky
    di bagian ini dibuang lebih dulu. */}
<section
  class="section section--bleed"
  id="projects"
  data-no-drift
  aria-labelledby="projects-title"
>
  <div class="shell">
    <span class="section__label">Projects</span>
    <h2 id="projects-title" class="rise">Three in depth, the rest in brief</h2>

    <article class="work rise">
      <header class="work__head">
        <h3>Student ID card forgery detection</h3>
        <p class="figure work__meta">
          Final year project · PyTorch, FastAPI, Next.js 14, OpenCV ·{" "}
          <a
            class="figure--verified"
            href="https://github.com/Dwiyuda/KTM-Detector-UIR-Skripsi_Public"
            rel="noopener">Repository</a
          >
        </p>
      </header>

      <p class="work__abstract">
        Card checks at the university library were a person looking at a card,
        and the printed QR code was never wired to any database. This is a
        four-stage pipeline that decides instead, and shows its reasoning. It
        reaches 97.74% accuracy and a 0.9912 ROC-AUC at native resolution, and
        runs in 4 GB of VRAM.
      </p>

      <ul class="chips" aria-label="Key figures">
        <li><span class="figure">1,645</span> images</li>
        <li><span class="figure">5</span> forgery scenarios</li>
        <li><span class="figure">4 GB</span> VRAM</li>
      </ul>

      <div class="screens rise-group">
        <figure class="screen">
          <Image
            src={shotAccepted}
            alt="The detector's result panel reading ASLI, meaning genuine,
              with 91.26% confidence and a probability bar for each class."
            widths={[520, 1100]}
            sizes="(min-width: 48rem) 46vw, 92vw"
            format="webp"
            loading="lazy"
          />
          <figcaption class="caption">
            Accepted. 91.26% confidence, above the gate.
          </figcaption>
        </figure>

        <figure class="screen">
          <Image
            src={shotRejected}
            alt="The same panel reading TIDAK DIKENALI, meaning unrecognised,
              because model confidence of 83.19% fell below the 85% threshold."
            widths={[520, 1100]}
            sizes="(min-width: 48rem) 46vw, 92vw"
            format="webp"
            loading="lazy"
          />
          <figcaption class="caption">
            Refused at 83.19%, below the 85% gate. It declines rather than
            guesses.
          </figcaption>
        </figure>
      </div>

      <figure class="screen screen--wide">
        <Image
          src={shotGradcam}
          alt="Grad-CAM view: the model input beside a heat map of the regions
            that drove the prediction, with a low-to-high colour legend."
          widths={[560, 1090]}
          sizes="(min-width: 48rem) 70vw, 92vw"
          format="webp"
          loading="lazy"
        />
        <figcaption class="caption">
          Grad-CAM over the same card. Card details are blurred here because
          the card belongs to someone else; the heat pattern is the point.
        </figcaption>
      </figure>

      <details class="deep">
        <summary><span>How the pipeline works</span></summary>
        <Pipeline name="ktm-pipeline" steps={pipeline} />
      </details>

      <div class="audit">
        <p class="audit__label figure">The audit</p>

        <p class="measure audit__gist">
          Four models scored a perfect 1.0000. I went looking for a data leak,
          found one that contaminated 29.1% of the test set, fixed it, and the
          accuracy did not move. The leak was real and it explained nothing.
        </p>

        {/* Sticky hold di sini butuh jalur samping dua kolom untuk perjalanan yang berguna; buktinya dan angkanya ada di laporan task 6, 58px tanpa itu tidak sepadan dikirim. */}
        <AuditDiagram />

        <details class="deep deep--audit">
          <summary><span>Read what happened next</span></summary>

          <div class="measure audit__rest">
            <p>
              Every forgery was built from a real card and kept its number, so{" "}
              <code>real_214</code> became <code>fake_214</code>. My split
              script shuffled the genuine files and the forged files
              independently, which let two halves of one physical card land on
              opposite sides of the train-test boundary. I rewrote the split to
              work on card families. Contamination went to zero.
            </p>

            <p class="audit__turn">Then I retrained, and it was still 1.0000.</p>

            <p>
              A five-fold group-aware cross-validation agreed. At 1024×474 the
              two classes genuinely do separate, and the contamination had been
              riding along without changing the outcome. I had spent the audit
              proving my own suspicion wrong, and reported it that way.
            </p>

            <p>
              My examiners raised a different objection. If every model scores
              1.0, there is no basis for saying which one is better. They asked
              for results that were not perfect.
            </p>

            <p>
              The quick way to do that is to make the numbers worse. I did not.
              Instead I ran a resolution ablation, holding every other parameter
              fixed and dropping the input to each architecture's native size,
              224×224 for B0 and 300×300 for B3. Accuracy fell to between{" "}
              <span class="figure">0.9606</span> and{" "}
              <span class="figure">0.9774</span> on its own, and the fall
              carried information: the model leans on high-frequency forensic
              traces that do not survive being shrunk.
            </p>

            <p>
              Every false negative in those runs came from one scenario. Font
              inconsistency. Not a single face swap, recapture, text patch, or
              hybrid got past. Four files defeated every native-resolution model
              I trained. Letterforms are the finest detail in the dataset, so
              they are the first thing to go when a card is squeezed to 224
              pixels wide.
            </p>
          </div>
        </details>
      </div>
    </article>

    <article class="work rise">
      <header class="work__head">
        <h3>Islamic family law assistant</h3>
        <p class="figure work__meta">
          Personal project · Python, FastAPI, BGE-M3, Qdrant, Next.js, Docker
          ·{" "}
          <a
            class="figure--verified"
            href="https://github.com/Dwiyuda/islamic-family-law-assistant"
            rel="noopener">Repository</a
          >
        </p>
      </header>

      <p class="work__abstract">
        Someone facing a divorce or an inheritance split in Indonesia usually
        starts with a search engine, which will answer confidently from the
        wrong law. This assistant answers only from the regulations, Qur'an and
        hadith in its corpus, cites the article it used, and refuses when it has
        no basis. Inheritance shares come from a rule engine in exact
        fractions. The language model explains them and never produces a
        number.
      </p>

      <ul class="chips" aria-label="Key figures">
        <li><span class="figure">2,491</span> source passages</li>
        <li><span class="figure">104</span> inheritance test cases</li>
        <li><span class="figure">395</span> tests passing in CI</li>
      </ul>

      <details class="deep">
        <summary
          ><span>How it decides, and where the numbers flatter it</span></summary
        >
        <Pipeline name="law-pipeline" steps={lawPipeline} />
      </details>
    </article>

    <article class="work rise">
      <header class="work__head">
        <h3>Automated practicum grading</h3>
        <p class="figure work__meta">
          Personal project, approved by the head of department · Python, Gemini
          2.5 Flash, Google Classroom API ·{" "}
          <a
            class="figure--verified"
            href="https://github.com/Dwiyuda/llm-practicum-grader"
            rel="noopener">Repository</a
          >
        </p>
      </header>

      <p class="work__abstract">
        Marking practicum submissions by hand across eight sessions is slow and
        drifts between the first script and the fortieth. This pulls
        submissions straight from Google Classroom, scores each one against the
        lecturer's rubric, and writes an Excel recap with feedback for every
        submission. Nothing it is unsure of counts until a person has looked.
        Phase one was accepted after its marks were checked against manual
        grading on 21 real submissions.
      </p>

      <ul class="chips" aria-label="Key figures">
        <li><span class="figure">21</span> real submissions graded</li>
        <li><span class="figure">2 of 8</span> sessions on the Classroom API</li>
        <li><span class="figure">4</span> kinds of file read</li>
      </ul>

      <details class="deep">
        <summary><span>How a submission moves through it</span></summary>
        <Pipeline name="grader-pipeline" steps={graderPipeline} />
      </details>

      <details class="deep">
        <summary><span>Design decisions, and one that went wrong</span></summary>
        <div class="measure deep__body">
          <p>
            No retrieval layer. The question, the key, the rubric and one
            submission always fit in a single prompt, so RAG would have been
            machinery with nothing to do.
          </p>
          <p>
            The one that went wrong is worth more than the ones that went right.
            A quiz on SQL shipped to the model without its table schema, so the
            model guessed at column names, and students who had used the real
            ones were marked down for it. One went from 7 to 34.4 after the
            schema was added and the rubric was told to accept aliases. Another
            went from 44 to 46.4. A rubric on another session was also summing
            to 105%.
          </p>
          <p>
            Both were caught by checking the machine's marks against marks given
            by hand, which is the only reason I trust the rest of them. The
            grader does earn its keep: it caught a foreign key pointing at the
            wrong table purely from reading, without running a line.
          </p>

          <p class="sheets__intro">
            Each run writes one workbook with three sheets:
          </p>
          <dl class="sheets">
            {
              sheets.map((s) => (
                <div class="sheets__row">
                  <dt class="figure">{s.name}</dt>
                  <dd class="caption">{s.cols}</dd>
                </div>
              ))
            }
          </dl>
          <p class="caption sheets__note">
            Only the column layout is shown. The real workbooks hold student
            names, email addresses, and marks, so none of it belongs here.
          </p>

          <p>
            Not built yet: similarity checking between students, and running the
            whole thing unattended on a server with n8n. Both are designed and
            written up in the repository. Neither has shipped.
          </p>
          <p>
            The public repository is a clean snapshot with a synthetic example,
            because the working one holds real class data and stays private. On
            that example the grader gave the correct submission 100 and the
            flawed one 49.5, which is exactly the rubric's ceiling for its three
            mistakes.
          </p>
        </div>
      </details>
    </article>

    {/* Tingkat dua. Dikelompokkan per fokus, AI paling atas, atas keputusan
        pemilik situs. Kartu memakai kisi .bento dari global.css. */}
    <div class="brief">
      <h3 class="brief__title rise">In brief</h3>
      {
        brief.map((g) => (
          <div class="brief__group">
            <h4 class="brief__heading">{g.heading}</h4>
            <div class="bento brief__grid rise-group">
              {g.items.map((p) => (
                <article class="brief__card">
                  <h5 class="brief__name">{p.title}</h5>
                  <p class="brief__text">{p.text}</p>
                  <ul class="chips" aria-label="Key figures">
                    {p.chips.map(([n, label]) => (
                      <li>
                        <span class="figure">{n}</span>
                        {" "}
                        {label}
                      </li>
                    ))}
                  </ul>
                  <p class="brief__stack">{p.stack}</p>
                  <a
                    class="figure figure--verified brief__repo"
                    href={p.repo}
                    rel="noopener"
                  >
                    Repository
                  </a>
                </article>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .work + .work {
    margin-top: 3.5rem;
    padding-top: 3.5rem;
    border-top: 1px solid var(--rule);
  }

  .work__head {
    margin-top: 3rem;
  }

  .work__head h3 {
    font-size: var(--size-subhead);
    line-height: 1.25;
  }

  .work__meta {
    margin-top: 0.4rem;
    color: var(--ink-soft);
  }

  .work__abstract {
    max-width: var(--measure);
    margin-top: 1.15rem;
  }

  /* Angka kunci sebagai baris chip, terbaca sebelum ada yang membuka apa pun */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .chips li {
    padding: 0.3rem 0.6rem;
    font-size: var(--size-caption);
    color: var(--ink-soft);
    border: 1px solid var(--rule);
    border-radius: 999px;
  }

  .chips .figure {
    color: var(--ink);
  }

  .screens {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.75rem;
  }

  @media (min-width: 48rem) {
    .screens {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
  }

  .screen {
    margin: 0;
  }

  .screen--wide {
    margin-top: 1.5rem;
    max-width: 46rem;
  }

