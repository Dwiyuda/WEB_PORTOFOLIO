const brief = lang === "en" ? briefEn : briefId;
---

{/* data-no-drift: AuditDiagram di bawah memasang view-transition-name pada 18
    chip. Transform di leluhur menjadikan bagian ini stacking context sekaligus
    containing block untuk semuanya — beban yang sama yang membuat aturan sticky
    di bagian ini dibuang lebih dulu. */}
<section
  class="section section--bleed"
  id="projects"
  data-no-drift
  aria-labelledby="projects-title"
>
  <div class="shell">
    <span class="section__label">{t.label}</span>
    <h2 id="projects-title" class="rise">{t.heading}</h2>

    <article class="work rise">
      <header class="work__head">
        <h3>{t.ktm.title}</h3>
        <p class="figure work__meta">
          {t.ktm.meta}{" "}
          <a
            class="figure--verified"
            href="https://github.com/Dwiyuda/KTM-Detector-UIR-Skripsi_Public"
            rel="noopener">{t.repository}</a
          >
        </p>
      </header>

      <p class="work__abstract">{t.ktm.abstract}</p>

      <ul class="chips" aria-label={t.keyFigures}>
        {t.ktm.chips.map(([n, label]) => (
          <li>
            <span class="figure">{n}</span>
            {" "}
            {label}
          </li>
        ))}
      </ul>

      <div class="screens rise-group">
        <figure class="screen">
          <Image
            src={shotAccepted}
            alt={t.ktm.acceptedAlt}
            widths={[520, 1100]}
            sizes="(min-width: 48rem) 46vw, 92vw"
            format="webp"
            loading="lazy"
          />
          <figcaption class="caption">{t.ktm.acceptedCap}</figcaption>
        </figure>

        <figure class="screen">
          <Image
            src={shotRejected}
            alt={t.ktm.rejectedAlt}
            widths={[520, 1100]}
            sizes="(min-width: 48rem) 46vw, 92vw"
            format="webp"
            loading="lazy"
          />
          <figcaption class="caption">{t.ktm.rejectedCap}</figcaption>
        </figure>
      </div>

      <figure class="screen screen--wide">
        <Image
          src={shotGradcam}
          alt={t.ktm.gradcamAlt}
          widths={[560, 1090]}
          sizes="(min-width: 48rem) 70vw, 92vw"
          format="webp"
          loading="lazy"
        />
        <figcaption class="caption">{t.ktm.gradcamCap}</figcaption>
      </figure>

      <details class="deep">
        <summary><span>{t.ktm.pipelineSummary}</span></summary>
        <Pipeline name="ktm-pipeline" steps={pipeline} />
      </details>

      <div class="audit">
        <p class="audit__label figure">{t.ktm.auditLabel}</p>

        <p class="measure audit__gist">{t.ktm.auditGist}</p>

        {/* Sticky hold di sini butuh jalur samping dua kolom untuk perjalanan yang berguna; buktinya dan angkanya ada di laporan task 6, 58px tanpa itu tidak sepadan dikirim. */}
        <AuditDiagram />

        <details class="deep deep--audit">
          <summary><span>{t.ktm.auditSummary}</span></summary>

          <div class="measure audit__rest">
            {lang === "id" ? (
              <Fragment>
                <p>
                  Setiap pemalsuan dibuat dari kartu asli dan mempertahankan
                  nomornya, jadi{" "}
                  <code>real_214</code> menjadi <code>fake_214</code>. Skrip
                  split saya mengacak berkas asli dan berkas palsu secara
                  terpisah, yang membuat dua paruh dari satu kartu fisik mendarat
                  di sisi berlawanan dari batas latih-uji. Saya menulis ulang
                  split agar bekerja per keluarga kartu. Kontaminasi turun ke nol.
                </p>

                <p class="audit__turn">
                  Lalu saya latih ulang, dan hasilnya tetap 1,0000.
                </p>

                <p>
                  Validasi silang lima-lipatan yang sadar-grup sepakat. Pada
                  1024×474 kedua kelas memang benar-benar terpisah, dan
                  kontaminasi itu selama ini hanya ikut menumpang tanpa mengubah
                  hasilnya. Saya menghabiskan audit itu untuk membuktikan
                  kecurigaan saya sendiri keliru, dan melaporkannya begitu.
                </p>

                <p>
                  Penguji saya mengajukan keberatan lain. Kalau setiap model
                  mencetak 1,0, tidak ada dasar untuk menyebut mana yang lebih
                  baik. Mereka meminta hasil yang tidak sempurna.
                </p>

                <p>
                  Cara cepatnya adalah membuat angkanya memburuk. Saya tidak
                  melakukannya. Sebagai gantinya saya menjalankan ablasi resolusi,
                  menahan setiap parameter lain tetap dan menurunkan input ke
                  ukuran native tiap arsitektur, 224×224 untuk B0 dan 300×300
                  untuk B3. Akurasi turun ke antara{" "}
                  <span class="figure">0,9606</span> dan{" "}
                  <span class="figure">0,9774</span> dengan sendirinya, dan
                  penurunan itu membawa informasi: model bersandar pada jejak
                  forensik frekuensi-tinggi yang tidak bertahan saat diperkecil.
                </p>

                <p>
                  Setiap false negative di run itu datang dari satu skenario.
                  Ketidakkonsistenan font. Tidak satu pun face swap, perekaman
                  ulang, tambalan teks, atau hibrida yang lolos. Empat berkas
                  mengalahkan setiap model resolusi-native yang saya latih. Bentuk
                  huruf adalah detail terhalus di dataset, jadi ia yang pertama
                  hilang saat kartu dipadatkan ke lebar 224 piksel.
                </p>
              </Fragment>
            ) : (
              <Fragment>
                <p>
                  Every forgery was built from a real card and kept its number,
                  so{" "}
                  <code>real_214</code> became <code>fake_214</code>. My split
                  script shuffled the genuine files and the forged files
                  independently, which let two halves of one physical card land
                  on opposite sides of the train-test boundary. I rewrote the
                  split to work on card families. Contamination went to zero.
                </p>

                <p class="audit__turn">Then I retrained, and it was still 1.0000.</p>

                <p>
                  A five-fold group-aware cross-validation agreed. At 1024×474
                  the two classes genuinely do separate, and the contamination
                  had been riding along without changing the outcome. I had spent
                  the audit proving my own suspicion wrong, and reported it that
                  way.
                </p>

                <p>
                  My examiners raised a different objection. If every model scores
                  1.0, there is no basis for saying which one is better. They
                  asked for results that were not perfect.
                </p>

                <p>
                  The quick way to do that is to make the numbers worse. I did
                  not. Instead I ran a resolution ablation, holding every other
                  parameter fixed and dropping the input to each architecture's
                  native size, 224×224 for B0 and 300×300 for B3. Accuracy fell
                  to between{" "}
                  <span class="figure">0.9606</span> and{" "}
                  <span class="figure">0.9774</span> on its own, and the fall
                  carried information: the model leans on high-frequency forensic
                  traces that do not survive being shrunk.
                </p>

                <p>
                  Every false negative in those runs came from one scenario. Font
                  inconsistency. Not a single face swap, recapture, text patch, or
                  hybrid got past. Four files defeated every native-resolution
                  model I trained. Letterforms are the finest detail in the
                  dataset, so they are the first thing to go when a card is
                  squeezed to 224 pixels wide.
                </p>
              </Fragment>
            )}
          </div>
        </details>
      </div>
    </article>

    <article class="work rise">
      <header class="work__head">
        <h3>{t.law.title}</h3>
        <p class="figure work__meta">
          {t.law.meta}{" "}
          <a
            class="figure--verified"
            href="https://github.com/Dwiyuda/islamic-family-law-assistant"
            rel="noopener">{t.repository}</a
          >
        </p>
      </header>

      <p class="work__abstract">{t.law.abstract}</p>

      <ul class="chips" aria-label={t.keyFigures}>
        {t.law.chips.map(([n, label]) => (
          <li>
            <span class="figure">{n}</span>
            {" "}
            {label}
          </li>
        ))}
      </ul>

      <details class="deep">
        <summary><span>{t.law.summary}</span></summary>
        <Pipeline name="law-pipeline" steps={lawPipeline} />
      </details>
    </article>

    <article class="work rise">
      <header class="work__head">
        <h3>{t.grader.title}</h3>
        <p class="figure work__meta">
          {t.grader.meta}{" "}
          <a
            class="figure--verified"
            href="https://github.com/Dwiyuda/llm-practicum-grader"
            rel="noopener">{t.repository}</a
          >
        </p>
      </header>

      <p class="work__abstract">{t.grader.abstract}</p>

      <ul class="chips" aria-label={t.keyFigures}>
        {t.grader.chips.map(([n, label]) => (
          <li>
            <span class="figure">{n}</span>
            {" "}
            {label}
          </li>
        ))}
      </ul>

      <details class="deep">
        <summary><span>{t.grader.pipelineSummary}</span></summary>
        <Pipeline name="grader-pipeline" steps={graderPipeline} />
      </details>

      <details class="deep">
        <summary><span>{t.grader.designSummary}</span></summary>
        <div class="measure deep__body">
          {t.grader.designTop.map((para) => <p>{para}</p>)}

          <p class="sheets__intro">{t.grader.sheetsIntro}</p>
          <dl class="sheets">
            {
              sheets.map((s) => (
                <div class="sheets__row">
                  <dt class="figure">{s.name}</dt>
                  <dd class="caption">{s.cols}</dd>
                </div>
              ))
            }
          </dl>
          <p class="caption sheets__note">{t.grader.sheetsNote}</p>

          {t.grader.designBottom.map((para) => <p>{para}</p>)}
        </div>
      </details>
    </article>

    {/* Tingkat dua. Dikelompokkan per fokus, AI paling atas, atas keputusan
        pemilik situs. Kartu memakai kisi .bento dari global.css. */}
    <div class="brief">
      <h3 class="brief__title rise">{t.briefTitle}</h3>
      {
        brief.map((g) => (
          <div class="brief__group">
            <h4 class="brief__heading">{g.heading}</h4>
            <div class="bento brief__grid rise-group">
              {g.items.map((p) => (
                <article class="brief__card">
                  <h5 class="brief__name">{p.title}</h5>
                  <p class="brief__text">{p.text}</p>
                  <ul class="chips" aria-label={t.keyFigures}>
                    {p.chips.map(([n, label]) => (
                      <li>
                        <span class="figure">{n}</span>
                        {" "}
                        {label}
                      </li>
                    ))}
                  </ul>
                  <p class="brief__stack">{p.stack}</p>
                  <p class="brief__links">
                    <a
                      class="figure figure--verified"
                      href={p.repo}
                      rel="noopener"
                    >
                      {t.repository}
                    </a>
                    {p.demo && (
                      <a
                        class="figure figure--verified"
                        href={p.demo.href}
                        target="_blank"
                        rel="noopener"
                      >
                        {p.demo.label}
                      </a>
                    )}
                  </p>
                </article>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .work + .work {
    margin-top: 3.5rem;
    padding-top: 3.5rem;
    border-top: 1px solid var(--rule);
  }

  .work__head {
    margin-top: 3rem;
  }

  .work__head h3 {
    font-size: var(--size-subhead);
    line-height: 1.25;
