---
import { Image } from "astro:assets";
import AuditDiagram from "./AuditDiagram.astro";
import shotAccepted from "../assets/detector-accepted.jpg";
import shotRejected from "../assets/detector-rejected.jpg";
import shotGradcam from "../assets/detector-gradcam.jpg";

// Tangkapan layar sudah melewati scripts/prep-screens.mjs. Setiap kartu
// identitas di dalamnya diburamkan sampai tidak terbaca, karena kartu itu
// milik orang lain. Jangan pernah memasang tangkapan mentah dari assets/.
//
// Keluaran LLM Grading tidak ditampilkan sebagai data. Berkas Excel-nya
// memuat nama, alamat surel, dan nilai mahasiswa. Yang ditayangkan hanya
// susunan kolomnya.
const sheets = [
  { name: "Rekap", cols: "NIM, name, status, total, confidence, needs review" },
  { name: "Detail", cols: "NIM, name, criterion, score, feedback" },
  { name: "Flag", cols: "NIM, name, status, reason for review" },
];

// Bagian 5. Sumber angka: HASIL_UJICOBA_TAMBAHAN/README.md (25 Juli 2026) dan
// metrics_summary.json tiap folder hasil, sudah dicocokkan satu per satu.
// Sumber LLM Grading: SISTEM_ASISTENSI_A/RINGKASAN_PROYEK.md (10 Juli 2026).
// Sumber Hening: SISTEM_SmartBand/README.md.
// Sumber tracker: FOLDER_PAYMENT_GEN_HALILINTAR/.../README.md.
//
// PENTING soal narasi. Perbaikan kebocoran 29% TIDAK menurunkan akurasi.
// Akurasi tetap 1,0000 setelah split dibersihkan. Yang menurunkannya ke
// 0,9606-0,9774 adalah ablasi resolusi. Jangan pernah menyandingkan angka
// 29% dengan 97,7% seolah yang satu menyebabkan yang lain.
//
// Bentuk tiap proyek: abstrak terbuka, kedalaman di balik <details>.
const pipeline = [
  {
    stage: "Qwen3-VL",
    role: "Semantic gate. Rejects anything that is not an ID card, zero-shot.",
    detail:
      "It has to throw out a photo of a desk, a hand, a blank wall, before any of that reaches the classifier. Evaluated separately with an LLM-as-a-judge pass over card and non-card images, where it scored perfectly.",
  },
  {
    stage: "Florence-2 + Canny",
    role: "Phrase grounding locates the card, then edge detection crops and deskews it.",
    detail:
      "Florence-2 says where the card is, Canny finds its edges, and the crop straightens it. The classifier never sees the desk it was lying on, so background stops being a feature it can cheat with.",
  },
  {
    stage: "EfficientNet-B0",
    role: "Binary classifier, genuine against forged.",
    detail:
      "Two-phase transfer learning from ImageNet: the head trains first with the backbone frozen, then the whole network fine-tunes. Mixup at alpha 0.4, AdamW, seed 42. The shipped model runs at 1024×474 and fits in 4 GB of VRAM.",
  },
  {
    stage: "Grad-CAM",
    role: "Heatmap over the region that drove the decision.",
    detail:
      "This is the part that keeps the rest honest. On a font forgery the heat sits on the text block; on a face swap it sits on the portrait. If it had lit up the background instead, the accuracy figure would have meant nothing.",
  },
];
---

<section class="section section--bleed" id="projects" aria-labelledby="projects-title">
  <div class="shell">
    <span class="section__label">Projects</span>
    <h2 id="projects-title" class="rise">Four I can defend line by line</h2>

    <article class="work rise">
      <header class="work__head">
        <h3>Student ID card forgery detection</h3>
        <p class="figure work__meta">
          Final year project · PyTorch, FastAPI, Next.js 14, OpenCV ·
          <a
            class="figure--verified"
            href="https://github.com/Dwiyuda/KTM-Detector-UIR-Skripsi_Public"
            rel="noopener">Repository</a
          >
        </p>
      </header>

      <p class="work__abstract">
        Card checks at the university library were a person looking at a card,
        and the printed QR code was never wired to any database. This is a
        four-stage pipeline that decides instead, and shows its reasoning. The
        model that ships scores 1.0000 across every metric on a group-aware
        split and fits in 4 GB of VRAM.
      </p>

      <ul class="chips" aria-label="Key figures">
        <li><span class="figure">1,645</span> images</li>
        <li><span class="figure">5</span> forgery scenarios</li>
        <li><span class="figure">4 GB</span> VRAM</li>
      </ul>

      <div class="screens rise-group">
        <figure class="screen">
          <Image
            src={shotAccepted}
            alt="The detector's result panel reading ASLI, meaning genuine,
              with 91.26% confidence and a probability bar for each class."
            widths={[520, 1100]}
            sizes="(min-width: 48rem) 46vw, 92vw"
            format="webp"
            loading="lazy"
          />
          <figcaption class="caption">
            Accepted. 91.26% confidence, above the gate.
          </figcaption>
        </figure>

        <figure class="screen">
          <Image
            src={shotRejected}
            alt="The same panel reading TIDAK DIKENALI, meaning unrecognised,
              because model confidence of 83.19% fell below the 85% threshold."
            widths={[520, 1100]}
            sizes="(min-width: 48rem) 46vw, 92vw"
            format="webp"
            loading="lazy"
          />
          <figcaption class="caption">
            Refused at 83.19%, below the 85% gate. It declines rather than
            guesses.
          </figcaption>
        </figure>
      </div>

      <figure class="screen screen--wide">
        <Image
          src={shotGradcam}
          alt="Grad-CAM view: the model input beside a heat map of the regions
            that drove the prediction, with a low-to-high colour legend."
          widths={[560, 1090]}
          sizes="(min-width: 48rem) 70vw, 92vw"
          format="webp"
          loading="lazy"
        />
        <figcaption class="caption">
          Grad-CAM over the same card. Card details are blurred here because
          the card belongs to someone else; the heat pattern is the point.
        </figcaption>
      </figure>

      <details class="deep">
        <summary><span>How the pipeline works</span></summary>
        <ol class="pipeline">
          {
            pipeline.map((p, i) => (
              <li class="pipeline__step">
                <details name="ktm-pipeline" open={i === 0}>
                  <summary>
                    <span class="pipeline__no figure">{`0${i + 1}`}</span>
                    <span class="pipeline__stage figure">{p.stage}</span>
                    <span class="pipeline__role">{p.role}</span>
                  </summary>
                  <p class="pipeline__detail">{p.detail}</p>
                </details>
              </li>
            ))
          }
        </ol>
      </details>

      <div class="audit">
        <p class="audit__label figure">The audit</p>

        <p class="measure audit__gist">
          Four models scored a perfect 1.0000. I went looking for a data leak,
          found one that contaminated 29.1% of the test set, fixed it, and the
          accuracy did not move. The leak was real and it explained nothing.
        </p>

        <div class="audit--hold">
          <AuditDiagram />
        </div>

        <details class="deep deep--audit">
          <summary><span>Read what happened next</span></summary>

          <div class="measure audit__rest">
            <p>
              Every forgery was built from a real card and kept its number, so{" "}
              <code>real_214</code> became <code>fake_214</code>. My split
              script shuffled the genuine files and the forged files
              independently, which let two halves of one physical card land on
              opposite sides of the train-test boundary. I rewrote the split to
              work on card families. Contamination went to zero.
            </p>

            <p class="audit__turn">Then I retrained, and it was still 1.0000.</p>

            <p>
              A five-fold group-aware cross-validation agreed. At 1024×474 the
              two classes genuinely do separate, and the contamination had been
              riding along without changing the outcome. I had spent the audit
              proving my own suspicion wrong, and reported it that way.
            </p>

            <p>
              My examiners raised a different objection. If every model scores
              1.0, there is no basis for saying which one is better. They asked
              for results that were not perfect.
            </p>

            <p>
              The quick way to do that is to make the numbers worse. I did not.
              Instead I ran a resolution ablation, holding every other parameter
              fixed and dropping the input to each architecture's native size,
              224×224 for B0 and 300×300 for B3. Accuracy fell to between{" "}
              <span class="figure">0.9606</span> and{" "}
              <span class="figure">0.9774</span> on its own, and the fall
              carried information: the model leans on high-frequency forensic
              traces that do not survive being shrunk.
            </p>

            <p>
              Every false negative in those runs came from one scenario. Font
              inconsistency. Not a single face swap, recapture, text patch, or
              hybrid got past. Four files defeated every native-resolution model
              I trained. Letterforms are the finest detail in the dataset, so
              they are the first thing to go when a card is squeezed to 224
              pixels wide.
            </p>
          </div>
        </details>
      </div>
    </article>

    <article class="work rise">
      <header class="work__head">
        <h3>Automated practicum grading</h3>
        <p class="figure work__meta">
          Personal project, approved by the head of department · Python, Gemini
          2.5 Flash
        </p>
      </header>

      <p class="work__abstract">
        Marking practicum submissions by hand across eight sessions is slow and
        drifts between the first script and the fortieth. This reads the
        question, the answer key, and the lecturer's rubric, scores each
        submission against it, and writes an Excel recap with per-student
        feedback. Phase one passed after its marks were calibrated against
        manual grading.
      </p>

      <ul class="chips" aria-label="Key figures">
        <li><span class="figure">8</span> sessions</li>
        <li><span class="figure">3</span> Excel sheets per run</li>
        <li><span class="figure">no</span> RAG</li>
      </ul>

      <details class="deep">
        <summary><span>Design decisions, and one that went wrong</span></summary>
        <div class="measure deep__body">
          <p>
            No retrieval layer. The whole context fits in one prompt, so RAG
            would have been machinery with nothing to do. Every output carries a
            confidence label, and anything below high confidence goes to a human
            before it counts. Answer keys drafted by the model are validated by
            the lecturer before they grade anything. Student code is read, never
            executed.
          </p>
          <p>
            The one that went wrong is worth more than the ones that went right.
            A quiz on SQL shipped to the model without its table schema, so the
            model guessed at column names, and students who had used the real
            ones were marked down for it. One went from 7 to 34.4 after the
            schema was added and the rubric was told to accept aliases. Another
            went from 44 to 46.4. A rubric on another session was also summing
            to 105%.
          </p>
          <p>
            Both were caught by checking the machine's marks against marks given
            by hand, which is the only reason I trust the rest of them. The
            grader does earn its keep: it caught a foreign key pointing at the
            wrong table purely from reading, without running a line.
          </p>

          <p class="sheets__intro">
            Each run writes one workbook with three sheets:
          </p>
          <dl class="sheets">
            {
              sheets.map((s) => (
                <div class="sheets__row">
                  <dt class="figure">{s.name}</dt>
                  <dd class="caption">{s.cols}</dd>
                </div>
              ))
            }
          </dl>
          <p class="caption sheets__note">
            Only the column layout is shown. The real workbooks hold student
            names, email addresses, and marks, so none of it belongs here.
          </p>
        </div>
      </details>
    </article>

    <article class="work rise">
      <header class="work__head">
        <h3>Hening, a reminder service that mostly stays quiet</h3>
        <p class="figure work__meta">
          Personal project · Cloudflare Workers, KV, OpenRouter, ntfy
        </p>
      </header>

      <p class="work__abstract">
        Reminder apps fail because the content never changes: drink water at
        ten, at twelve, at two, whether or not you are in a meeting. Hening asks
        a model once an hour whether interrupting is worth it at all. Out of
        sixteen chances a day it says yes six to eight times. The silence is the
        feature.
      </p>

      <ul class="chips" aria-label="Key figures">
        <li><span class="figure">16</span> checks a day</li>
        <li><span class="figure">6–8</span> actually sent</li>
        <li><span class="figure">&lt;$1</span> a month</li>
      </ul>

      <details class="deep">
        <summary><span>What the prompt has to get right</span></summary>
        <div class="measure deep__body">
          <p>
            The hard part is not the code, it is telling the model that saying
            nothing is a valid answer and that the daily quota is not a target
            to hit. Three rules keep it from collapsing. A notification whose
            button was never pressed is logged as no response rather than
            ignored, because a busy person is not a refusal, and treating it as
            one makes the system go mute within days. Context older than ninety
            minutes is flagged as stale so it never tells someone they have been
            sitting for eight hours when their phone spent the night on a table.
            And the model returns structured JSON with a reason field, which is
            what makes calibration possible: you can read why it chose to stay
            quiet.
          </p>
          <p>
            The README lists what it cannot do, and that list matters. The band
            is output only, since Huawei exposes no open API. What gets detected
            is the state of a phone, not the state of a person. Motorbikes are
            regularly classified as bicycles.
          </p>
        </div>
      </details>
    </article>

    <article class="work rise">
      <header class="work__head">
        <h3>Cohort payment tracker</h3>
        <p class="figure work__meta">
          Built for my year group · Google Apps Script, Sheets
        </p>
      </header>

      <p class="work__abstract">
        Nineteen of us owed each other money on a rotating schedule: every time
        one person defends, the other eighteen contribute. Tracking that in a
        chat thread does not survive contact with reality. This is a 19×19
        matrix in Sheets with a small web form for updating from a phone, and a
        dashboard that recalculates itself because every column is a formula.
      </p>

      <ul class="chips" aria-label="Key figures">
        <li><span class="figure">19×19</span> matrix</li>
        <li><span class="figure">3</span> live charts</li>
      </ul>

      <details class="deep">
        <summary><span>Why a spreadsheet and not an app</span></summary>
        <div class="measure deep__body">
          <p>
            The people using it already lived in Sheets, and the whole thing had
            to be maintainable by someone who is not me after I graduate. Apps
            Script meant no hosting, no database, and no account for anyone to
            forget the password to. Duplicate entries are rejected at the form
            rather than cleaned up later, and the diagonal of the matrix is
            protected so nobody can pay themselves.
          </p>
          <p>
            The repository stays private on purpose. The deployment URL is a
            write endpoint with no authentication, which is fine for a group of
            nineteen with the link and not fine in public.
          </p>
        </div>
      </details>
    </article>
  </div>
</section>

<style>
  .work + .work {
    margin-top: 3.5rem;
    padding-top: 3.5rem;
    border-top: 1px solid var(--rule);
  }

  .work__head {
    margin-top: 3rem;
  }

  .work__head h3 {
    font-size: var(--size-subhead);
    line-height: 1.25;
  }

  .work__meta {
    margin-top: 0.4rem;
    color: var(--ink-soft);
  }

  .work__abstract {
    max-width: var(--measure);
    margin-top: 1.15rem;
  }

  /* Angka kunci sebagai baris chip, terbaca sebelum ada yang membuka apa pun */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .chips li {
    padding: 0.3rem 0.6rem;
    font-size: var(--size-caption);
    color: var(--ink-soft);
    border: 1px solid var(--rule);
    border-radius: 999px;
  }

  .chips .figure {
    color: var(--ink);
  }

  .screens {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.75rem;
  }

  @media (min-width: 48rem) {
    .screens {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
  }

  .screen {
    margin: 0;
  }

  .screen--wide {
    margin-top: 1.5rem;
    max-width: 46rem;
  }

  .screen img {
    width: 100%;
    border: 1px solid var(--rule);
    border-radius: 2px;
    cursor: zoom-in;
    transition: border-color var(--t-fast) var(--ease);
  }

  .screen:hover img {
    border-color: var(--verified);
  }

  .screen figcaption {
    margin-top: 0.6rem;
  }

  /* Susunan lembar Excel. Kolom saja, tanpa satu baris data pun. */
  .sheets {
    margin: 0.9rem 0 0;
    border-top: 1px solid var(--rule);
  }

  .sheets__row {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: 0.9rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .sheets__row dt {
    color: var(--verified);
  }

  .sheets__row dd {
    margin: 0;
  }

  .sheets__note {
    margin-top: 0.9rem;
  }

  /* Pengungkap kedalaman. Ringkasan tetap terbaca tanpa membuka apa pun. */
  .deep {
    margin-top: 1.5rem;
  }

  .deep > summary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--size-caption);
    color: var(--verified);
    cursor: pointer;
    list-style: none;
  }

  .deep > summary::-webkit-details-marker {
    display: none;
  }

  .deep > summary::before {
    content: "";
    width: 0;
    height: 0;
    border-left: 5px solid currentColor;
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
    transition: transform var(--t-mid) var(--ease-out);
  }

  .deep[open] > summary::before {
    transform: rotate(90deg);
  }

  .deep > summary span {
    border-bottom: 1px solid transparent;
    transition: border-color var(--t-fast) var(--ease);
  }

  .deep > summary:hover span {
    border-bottom-color: currentColor;
  }

  .deep__body {
    margin-top: 1.1rem;
  }

  .deep__body p + p {
    margin-top: 1.1rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .deep[open] > :not(summary) {
      animation: slide-down var(--t-mid) var(--ease-out);
    }
  }

  @keyframes slide-down {
    from {
      opacity: 0;
      transform: translateY(-0.4rem);
    }
  }

  .pipeline {
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 3px;
    overflow: hidden;
  }

  .pipeline__step + .pipeline__step {
    border-top: 1px solid var(--rule);
  }

  .pipeline summary {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 11rem) 1fr;
    align-items: baseline;
    gap: 0.35rem 0.75rem;
    padding: 0.95rem 1.1rem;
    cursor: pointer;
    list-style: none;
    background: var(--paper-raised);
    transition: background var(--t-fast) var(--ease);
  }

  .pipeline summary::-webkit-details-marker {
    display: none;
  }

  .pipeline summary:hover {
    background: color-mix(in srgb, var(--verified) 7%, var(--paper-raised));
  }

  @media (max-width: 44rem) {
    .pipeline summary {
      grid-template-columns: 2.25rem 1fr;
    }
    .pipeline__role {
      grid-column: 2;
    }
  }

  .pipeline__no {
    color: var(--ink-soft);
    font-size: 0.75rem;
  }

  .pipeline__stage {
    color: var(--verified);
  }

  .pipeline__role {
    font-size: var(--size-caption);
    line-height: 1.5;
    color: var(--ink-soft);
  }

  /* Latar dipasang di <details>, bukan di paragrafnya. Paragraf dibatasi
     lebar bacanya, jadi kalau latar ikut menempel di sana sisa barisnya
     menembus ke latar bagian dan terbaca sebagai kotak kosong. */
  .pipeline details {
    background: var(--paper-raised);
  }

  .pipeline__detail {
    max-width: var(--measure);
    margin: 0;
    padding: 0 1.1rem 1.15rem calc(2.25rem + 1.85rem);
    font-size: var(--size-figure);
    line-height: 1.65;
    color: var(--ink-soft);
  }

  @media (max-width: 44rem) {
    .pipeline__detail {
      padding-left: 1.1rem;
    }
  }

  /* Satu-satunya tempat terakota dipakai di seluruh halaman. Sisipan
     bertepi lurus dengan garis di atas dan label duduk di garis itu. */
  .audit {
    position: relative;
    margin-top: 3.25rem;
    padding: 2rem 0 0;
    border-top: 2px solid var(--before-audit);
  }

  .audit__label {
    position: absolute;
    top: 0;
    left: 0;
    transform: translateY(-50%);
    padding-right: 0.85rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--before-audit);
    background: var(--paper);
  }

  .audit__gist {
    margin: 0;
  }

  .audit__rest p + p {
    margin-top: 1.1rem;
  }

  .deep--audit {
    margin-top: 1.75rem;
  }

  /* Titik balik cerita. Satu kalimat yang membatalkan kecurigaan penulis
     sendiri, jadi diberi ruang seperti kutipan. */
  .audit__turn {
    max-width: 22ch;
    margin-block: 1.75rem;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 1.15rem + 1.2vw, 1.95rem);
    line-height: 1.22;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .audit code {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  /* Satu-satunya penahanan baru di halaman. Yang pertama pelat spesifikasi di
     Experience, jadi ini yang kedua dan terakhir — PRD melarang lebih dari dua.
     Papan diagram menempel sementara prosa di sekitarnya bergulir, sehingga
     pembaca menghabiskan lebih banyak detik di bagian ini daripada di mana pun.
     Itulah cara Proyek disorot, menggantikan kontras lantai. */
  .audit--hold {
    position: sticky;
    top: 4rem;
  }

  /* Penahanan hanya berlaku kalau ada ruang untuk menahan. Di layar pendek
     posisi sticky justru memakan tinggi baca. */
  @media (max-height: 44rem) {
    .audit--hold {
      position: static;
    }
  }
</style>
