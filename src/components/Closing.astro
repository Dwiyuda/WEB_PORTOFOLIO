---
// Bagian 10, penutup.
//
// Sengaja TIDAK menyebut status pencarian kerja maupun tanggal kelulusan.
// Penutup ini menggambarkan cara kerja, bukan keadaan sesaat, supaya
// halamannya tidak basi begitu keadaan itu berubah.
//
// Ketiga contoh yang disebut semuanya nyata dan ada di halaman ini:
// kebocoran dataset, kunci jawaban yang salah menilai, dan website HIMATIF
// yang diarahkan tapi tidak ditulis sendiri.
//
// Nomor telepon tidak ditayangkan.
const lang = Astro.currentLocale === "en" ? "en" : "id";
const t = {
  id: {
    label: "Penutup",
    heading: "Benang merahnya",
    line: "Sebagian besar halaman ini adalah catatan tentang memeriksa berbagai hal.",
    paras: [
      "Dataset yang ternyata terkontaminasi. Kunci jawaban yang menilai jawaban benar sebagai salah. Website yang saya arahkan tapi tidak saya tulis sendiri, dan saya nyatakan itu di halaman alih-alih berharap tidak ada yang bertanya.",
      "Tidak satu pun dari pemeriksaan itu membuat angka jadi lebih besar. Yang mereka lakukan adalah meninggalkan saya dengan angka yang masih bisa saya pertanggungjawabkan ketika seseorang bertanya bagaimana angka itu dihasilkan. Itulah kebiasaan yang saya ingin Anda bawa dari sini, lebih dari hasil mana pun di atasnya.",
    ],
    colophonPre:
      "Dibangun dengan Astro. Tidak memasang cookie dan tidak menjalankan analytics. Setiap angka di halaman ini bisa ditelusuri kembali ke sebuah dokumen, dan kodenya ada",
    colophonLink: "di GitHub",
  },
  en: {
    label: "In closing",
    heading: "The through line",
    line: "Most of this page is a record of checking things.",
    paras: [
      "A dataset that turned out to be contaminated. An answer key that marked correct answers wrong. A website I directed but did not write, and said so on the page rather than hoping nobody asked.",
      "Not one of those checks made a number larger. What they did was leave me with numbers I can still stand behind when someone asks how they were produced. That is the habit I would want you to take from here, more than any single result above it.",
    ],
    colophonPre:
      "Built with Astro. It sets no cookies and runs no analytics. Every figure on this page traces back to a document, and the source is",
    colophonLink: "on GitHub",
  },
}[lang];
---

<section class="section close" id="contact" aria-labelledby="closing-title">
  <div class="shell">
    <span class="section__label">{t.label}</span>
    <h2 id="closing-title" class="rise">{t.heading}</h2>

    <div class="close__grid">
      <div class="close__text rise">
        <p class="close__line">{t.line}</p>
        {t.paras.map((para) => <p>{para}</p>)}
      </div>

      <div class="close__links rise">
        <a class="close__mail" href="mailto:dwiiyudaaa@gmail.com">
          dwiiyudaaa@gmail.com
        </a>
        <ul class="close__list">
          <li>
            <a class="figure" href="https://www.linkedin.com/in/dwi-yuda"
              >linkedin.com/in/dwi-yuda</a
            >
          </li>
          <li>
            <a class="figure" href="https://github.com/Dwiyuda"
              >github.com/Dwiyuda</a
            >
          </li>
        </ul>
        <p class="caption close__where">Pekanbaru, Riau, Indonesia</p>
      </div>
    </div>

    <p class="caption colophon">
      {t.colophonPre}{" "}
      <a href="https://github.com/Dwiyuda/WEB_PORTOFOLIO" rel="noopener"
        >{t.colophonLink}</a
      >.
    </p>
  </div>
</section>

<style>
  .close__grid {
    display: grid;
    gap: 2.5rem;
    margin-top: 2.5rem;
  }

  @media (min-width: 52rem) {
    .close__grid {
      grid-template-columns: minmax(0, 1fr) 16rem;
      gap: 3.5rem;
      align-items: start;
    }
  }

  .close__text {
    max-width: var(--measure);
  }

  .close__line {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 1.15rem + 1.2vw, 1.95rem);
    line-height: 1.25;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .close__text p + p {
    margin-top: 1.2rem;
    color: var(--ink-soft);
  }

  .close__mail {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.15rem);
    color: var(--verified);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--verified) 40%, transparent);
    transition: border-color var(--t-fast) var(--ease-out);
  }

  .close__mail:hover {
    border-bottom-color: var(--verified);
  }

  .close__list {
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .close__list li + li {
    margin-top: 0.5rem;
  }

  .colophon {
    max-width: 46ch;
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .close__where {
    margin-top: 1.25rem;
  }

</style>
