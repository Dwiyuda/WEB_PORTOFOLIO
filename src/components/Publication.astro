---
// Bagian 7. Sumber: Publikasi I-Com 2025.
// PRD mewajibkan pembaca tahu ini jurnal pengabdian nasional, bukan Scopus,
// dan tahu posisi penulis ke-7 dari 11. Jangan hapus paragraf kualifikasi.
// Naskah ITJRD sengaja belum masuk sini, statusnya belum dipastikan.
//
// Bentuknya entri daftar pustaka dengan takik gantung, bukan kartu. Bagian
// ini soal publikasi akademik, jadi konvensinya sendiri yang dipakai.
const authorCount = 11;
const authorPosition = 7;
---

<section class="section" id="publication" aria-labelledby="publication-title">
  <div class="shell">
    <span class="section__label">Publication</span>
    <h2 id="publication-title" class="rise">One article, and what it is not</h2>

    <div class="entry rise">
      <p class="entry__cite">
        Susanti, H., <em>et al.</em> (2025). Pemberdayaan Desa Binaan Berbasis
        Budaya Hukum dengan Penerapan (SIMDES) Sistem Informasi Transparansi
        Dana Desa di Pulau Gadang. <em
          >I-Com: Indonesian Community Journal</em
        >, 5(1), 333–342.
        <a
          class="entry__doi"
          href="https://doi.org/10.70609/icom.v5i1.6599"
          rel="noopener">https://doi.org/10.70609/icom.v5i1.6599</a
        >
      </p>

      <div class="byline">
        <span class="caption byline__label">
          Author {authorPosition} of {authorCount}
        </span>
        <ol
          class="byline__pips"
          aria-label={`Seventh author of eleven`}
          role="img"
        >
          {
            Array.from({ length: authorCount }, (_, i) => (
              <li
                class:list={[
                  "byline__pip",
                  { "byline__pip--me": i + 1 === authorPosition },
                ]}
              />
            ))
          }
        </ol>
      </div>
    </div>

    <div class="qualify measure rise">
      <p>
        The team was led by Dr. Heni Susanti from the law faculty, and the
        article reports the village programme rather than a study of my own.
      </p>
      <p>
        I-Com is a national community-service journal. It is not Scopus-indexed
        and it is not a research venue. Read it as external evidence that the
        village work happened, and nothing more than that.
      </p>
    </div>
  </div>
</section>

<style>
  .entry {
    margin-top: 2.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--rule);
  }

  /* Takik gantung, konvensi daftar pustaka. */
  .entry__cite {
    max-width: 46rem;
    padding-left: 2.25rem;
    text-indent: -2.25rem;
    line-height: 1.7;
  }

  .entry__doi {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--verified);
    word-break: break-all;
  }

  .byline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.9rem;
    margin-top: 1.5rem;
  }

  .byline__label {
    font-family: var(--font-mono);
  }

  /* Sebelas penulis, yang ketujuh ditandai. Posisi itu fakta yang mudah
     dikaburkan kalau hanya ditulis, jadi ditunjukkan. */
  .byline__pips {
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .byline__pip {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--rule);
  }

  .byline__pip--me {
    background: var(--verified);
    transform: scale(1.3);
  }

  .qualify {
    margin-top: 2rem;
    color: var(--ink-soft);
  }

  .qualify p + p {
    margin-top: 1.1rem;
  }
</style>
