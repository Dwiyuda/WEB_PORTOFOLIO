---
// Bagian 8. Dulu bagian Record yang menayangkan IPK, IP semester, jumlah SKS,
// dan tautan KHS. Diubah jadi Sertifikasi pada 18 Agustus 2026 atas keputusan
// pemilik situs.
//
// KHS dihapus bukan cuma soal selera: berkasnya memuat NPM dan nama lengkap
// dosen pembimbing akademik, yaitu data pribadi orang lain yang tidak pernah
// menyetujui namanya tayang di halaman publik. Jangan dikembalikan.
//
// Bentuknya daftar entri, bukan kisi angka. Kisi angka dipakai untuk metrik
// pendek; nama sertifikat adalah frasa, dan memaksanya ke gaya angka besar
// membuatnya pecah. Daftar ini juga tumbuh rapi saat sertifikat bertambah.
//
// Sumber: sertifikat Cisco Networking Academy 10 Agustus 2024.
//
// Belum ada tautan verifikasi. Halaman Credly untuk ID sertifikat ini membalas
// "unable to verify the status of this badge", hampir pasti karena badge-nya
// belum diklaim. Tautan yang gagal memverifikasi lebih merugikan daripada
// tidak ada tautan sama sekali, di halaman yang seluruh tesisnya soal bukti
// yang bisa diperiksa orang lain. Pasang `verify` setelah badge diklaim dan
// halamannya benar-benar hidup.
const certifications = [
  {
    name: "CCNAv7: Introduction to Networks",
    issuer: "Cisco Networking Academy",
    date: "August 2024",
    verify: null,
  },
];
---

<section class="section" id="achievements" aria-labelledby="achievements-title">
  <div class="shell">
    <span class="section__label">Certification</span>
    <h2 id="achievements-title" class="rise">
      Certifications, and who issued them
    </h2>

    <ol class="certs rise-group">
      {
        certifications.map((c) => (
          <li class="cert">
            <p class="cert__name">{c.name}</p>
            <p class="cert__meta">
              {c.issuer} · {c.date}
            </p>
            {c.verify && (
              <p class="cert__verify">
                <a class="figure figure--verified" href={c.verify}>
                  Verify with the issuer
                </a>
              </p>
            )}
          </li>
        ))
      }
    </ol>

    <div class="measure record__note rise">
      <p>Four years, September 2022 to July 2026, with no repeated course.</p>
    </div>
  </div>
</section>

<style>
  .certs {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    max-width: var(--measure);
    border-top: 1px solid var(--rule);
  }

  .cert {
    padding: 1.35rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .cert__name {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: 600;
    font-size: var(--size-subhead);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .cert__meta {
    font-family: var(--font-mono);
    font-size: var(--size-caption);
    color: var(--ink-soft);
    margin-top: 0.4rem;
  }

  .cert__verify {
    margin-top: 0.7rem;
  }

  .record__note {
    margin-top: 2.25rem;
  }

  .record__note p + p {
    margin-top: 1.25rem;
  }
</style>
