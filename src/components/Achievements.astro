---
// Bagian 8. Dulu bagian Record yang menayangkan IPK, IP semester, jumlah SKS,
// dan tautan KHS. Diubah jadi Sertifikasi pada 18 Agustus 2026 atas keputusan
// pemilik situs.
//
// KHS dihapus bukan cuma soal selera: berkasnya memuat NPM dan nama lengkap
// dosen pembimbing akademik, yaitu data pribadi orang lain yang tidak pernah
// menyetujui namanya tayang di halaman publik. Jangan dikembalikan.
//
// Bentuknya daftar entri, bukan kisi angka. Kisi angka dipakai untuk metrik
// pendek; nama sertifikat adalah frasa, dan memaksanya ke gaya angka besar
// membuatnya pecah. Daftar ini juga tumbuh rapi saat sertifikat bertambah.
//
// Sumber: badge Credly yang sudah diklaim, diverifikasi langsung di peramban
// 18 Agustus 2026. Halamannya menyatakan "This badge was issued to Dwi Yuda",
// "Date issued: August 10, 2024", "Issued by Cisco".
//
// Namanya "CCNA", BUKAN "CCNAv7". PDF sertifikatnya menulis CCNAv7, tapi yang
// dipakai di sini nama persis seperti di halaman verifikasi — pembaca yang
// mengklik akan membandingkan keduanya, dan selisih sekecil "v7" pun menimbulkan
// keraguan yang justru merusak guna tautan verifikasi.
//
// Kualifikasinya wajib ada. Deskripsi Credly sendiri menyebut ini "student level
// credential", jadi ini kredensial kursus tingkat mahasiswa, BUKAN sertifikasi
// profesional CCNA. Tanpa kalimat itu pembaca bisa salah mengira sebaliknya, dan
// aturan situs ini cuma mengizinkan klaim yang bisa dipertahankan saat wawancara.
// Ini logika yang sama dengan bagian Publikasi, yang wajib menyatakan jurnalnya
// pengabdian nasional dan penulisnya ke-7 dari 11.
const certifications = [
  {
    name: "CCNA: Introduction to Networks",
    issuer: "Cisco Networking Academy",
    date: "August 2024",
    verify:
      "https://www.credly.com/badges/1479df3b-8a32-4618-a3b0-edeedbe34cc1/public_url",
    // Sertifikat aslinya, dibuka di viewer PDF peramban seperti CV — tanpa
    // atribut `download`. Isinya cuma nama sendiri, nama kursus, tanggal, Cert
    // ID, dan tanda tangan Direktur Cisco Networking Academy yang tercetak di
    // jutaan sertifikat yang sama. Tidak ada data pribadi pihak ketiga, jadi
    // aman ditayangkan — berbeda dari KHS yang memuat nama dosen PA.
    //
    // Catatan: PDF menulis "CCNAv7", halaman Credly menulis "CCNA". Yang
    // ditayangkan versi Credly, karena itu yang dibandingkan pembaca.
    pdf: "/cisco-ccna-intro-to-networks.pdf",
  },
];

// Kaggle Learn. Delapan kursus pendek (beberapa jam tiap kursus), bukan
// kompetisi atau sertifikasi profesional — ditulis apa adanya di catatan di
// bawah daftar, aturan yang sama dengan kualifikasi "student level" pada CCNA.
// Artefaknya berkas sertifikat di public/certs/: hanya nama sendiri, nama
// kursus, dan tanggal; tidak ada data pihak ketiga, jadi aman ditayangkan.
// freeCodeCamp sengaja tidak diklaim karena klaimnya dilewati pemilik situs.
const kaggle = [
  { name: "Python", img: "/certs/kaggle-python.png" },
  { name: "Pandas", img: "/certs/kaggle-pandas.png" },
  { name: "Intro to Machine Learning", img: "/certs/kaggle-intro-to-ml.png" },
  {
    name: "Intermediate Machine Learning",
    img: "/certs/kaggle-intermediate-ml.png",
  },
  { name: "Feature Engineering", img: "/certs/kaggle-feature-engineering.png" },
  { name: "Data Visualization", img: "/certs/kaggle-data-visualization.png" },
  { name: "Intro to SQL", img: "/certs/kaggle-intro-to-sql.png" },
  { name: "Advanced SQL", img: "/certs/kaggle-advanced-sql.png" },
];

const lang = Astro.currentLocale === "en" ? "en" : "id";
// Bulan diterjemahkan saat tampil, jadi sertifikat baru cukup ditulis dengan
// nama bulan Inggris di array di atas dan ikut benar di versi Indonesia.
const months: Record<string, string> = {
  January: "Januari", February: "Februari", March: "Maret", April: "April",
  May: "Mei", June: "Juni", July: "Juli", August: "Agustus",
  September: "September", October: "Oktober", November: "November", December: "Desember",
};
const localeDate = (d: string) =>
  lang === "en" ? d : d.replace(/^(\w+)/, (m) => months[m] ?? m);

const t = {
  id: {
    label: "Sertifikasi",
    heading: "Sertifikat, dan siapa yang menerbitkannya",
    verify: "Verifikasi via Cisco",
    pdf: "Sertifikat (PDF)",
    kaggleNote:
      "Jalur Learn dari Kaggle berisi kursus pendek yang langsung praktik, masing-masing beberapa jam. Kursus-kursus itu dicantumkan karena cakupan SQL, pandas, machine learning, dan visualisasi data yang diajarkannya, bukan sebagai kualifikasi formal. Masing-masing tertaut ke sertifikatnya.",
    record: [
      "Ini kredensial kursus Networking Academy, pada tingkat mahasiswa. Ia bukan sertifikasi profesional CCNA, dan badge di atas menyatakannya dengan kata-katanya sendiri.",
      "Empat tahun, September 2022 sampai Juli 2026, tanpa mengulang mata kuliah.",
    ],
  },
  en: {
    label: "Certification",
    heading: "Certifications, and who issued them",
    verify: "Verify with Cisco",
    pdf: "Certificate, PDF",
    kaggleNote:
      "Kaggle's Learn track is short, hands-on courses, a few hours each. They are listed for the SQL, pandas, machine-learning and data-visualisation ground they cover, not as formal qualifications. Each links to its certificate.",
    record: [
      "This is the Networking Academy course credential, at student level. It is not the professional CCNA certification, and the badge above says so in its own words.",
      "Four years, September 2022 to July 2026, with no repeated course.",
    ],
  },
}[lang];
---

<section class="section" id="achievements" aria-labelledby="achievements-title">
  <div class="shell">
    <span class="section__label">{t.label}</span>
    <h2 id="achievements-title" class="rise">{t.heading}</h2>

    <ol class="certs rise-group">
      {
        certifications.map((c) => (
          <li class="cert">
            <p class="cert__name">{c.name}</p>
            <p class="cert__meta">
              {c.issuer} · {localeDate(c.date)}
            </p>
            <p class="cert__links">
              {c.verify && (
                <a
                  class="cert__link"
                  href={c.verify}
                  target="_blank"
                  rel="noopener"
                >
                  {t.verify}
                </a>
              )}
              {c.pdf && (
                <a
                  class="cert__link"
                  href={c.pdf}
                  target="_blank"
                  rel="noopener"
                >
                  {t.pdf}
                </a>
              )}
            </p>
          </li>
        ))
      }
    </ol>

    <div class="kaggle rise">
      <p class="kaggle__label">Kaggle Learn</p>
      <ul class="kaggle__list">
        {
          kaggle.map((k) => (
            <li>
              <a class="cert__link" href={k.img} target="_blank" rel="noopener">
                {k.name}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="measure caption kaggle__note">{t.kaggleNote}</p>
    </div>

    <div class="measure record__note rise">
      {t.record.map((para) => <p>{para}</p>)}
    </div>
  </div>
</section>

<style>
  .certs {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    max-width: var(--measure);
    border-top: 1px solid var(--rule);
  }

  .cert {
    padding: 1.35rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .cert__name {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: 600;
    font-size: var(--size-subhead);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .cert__meta {
    font-family: var(--font-mono);
    font-size: var(--size-caption);
    color: var(--ink-soft);
    margin-top: 0.4rem;
  }

  /* Meniru gaya .deep > summary di Projects.astro: mono, teal, dengan
     segitiga CSS. Dipakai supaya "buka berkas" terbaca sebagai satu bahasa
     visual di seluruh situs, bukan tombol baru yang berdiri sendiri. */
  .cert__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 0.8rem;
  }

  .cert__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--size-caption);
    color: var(--verified);
    text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
    text-underline-offset: 0.25em;
  }

  .cert__link::before {
    content: "";
    width: 0;
    height: 0;
    border-left: 5px solid currentColor;
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
    transition: transform var(--t-fast) var(--ease-out);
  }

  .cert__link:hover::before {
    transform: translateX(2px);
  }

  /* Blok Kaggle: lebih ringan dari entri .cert di atasnya, supaya kursus
     pendek tidak tampil setara kredensial Cisco. Memakai .cert__link yang
     sama agar "buka berkas" tetap satu bahasa visual. */
  .kaggle {
    margin-top: 2.75rem;
    max-width: var(--measure);
  }

  .kaggle__label {
    font-family: var(--font-mono);
    font-size: var(--size-caption);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .kaggle__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }

  .kaggle__note {
    margin-top: 1.25rem;
  }

  .record__note {
    margin-top: 2.25rem;
  }

  .record__note p + p {
    margin-top: 1.25rem;
  }
</style>
