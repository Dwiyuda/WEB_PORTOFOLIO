---
// Bagian 9. Aturan PRD: tanpa persentase, dan tiap tool disebut dipakai di
// mana. Kalau sebuah tool tidak bisa ditautkan ke pekerjaan nyata, tool itu
// tidak masuk daftar. TensorFlow/Keras dan React ada di CV tapi belum ada
// proyek di halaman ini yang bisa disebut, jadi sengaja tidak dicantumkan.
// Diperbarui 21 Okt 2026 mengikuti proyek baru di bagian Projects.
const groups = [
  {
    heading: "Modelling",
    items: [
      ["PyTorch", "The ID card detector and the plant-disease classifier"],
      ["Hugging Face Transformers", "Qwen3-VL and Florence-2 in the detector"],
      ["Ultralytics YOLO", "Locating lesions on eggplant leaves"],
      ["XGBoost", "Ranking eligible houses by urgency"],
      ["Scikit-learn", "Group-aware splits, and K-Means for village aid"],
      ["OpenCV", "Canny edge detection and deskewing before classification"],
      ["Grad-CAM", "Checking which region drove each decision"],
    ],
  },
  {
    heading: "Retrieval and LLMs",
    items: [
      ["BM25, BGE-M3, reranker", "Hybrid retrieval in the family law assistant"],
      ["Qdrant", "Vector store for the family law corpus"],
      ["Neo4j, Graph RAG", "The knowledge graph behind plant-disease advice"],
      ["Gemini, Groq, OpenRouter", "Grading, grounded answers, the LVLM study"],
      ["Prompt engineering", "Five prompt designs across four vision models"],
    ],
  },
  {
    heading: "Evaluation",
    items: [
      ["Group-aware splitting", "Rebuilt the thesis split by card family"],
      ["ROC-AUC, confusion matrix", "Reported per model and per split"],
      ["Ablation study", "Resolution ablation that broke the 1.0 ceiling"],
      ["Robustness benchmark", "JPEG, blur, occlusion, rotation, noise"],
      ["RAGAS", "Faithfulness and recall for two RAG systems"],
      ["McNemar with Holm", "Comparing models on the same test images"],
      ["LLM-as-a-judge", "Independent check on the semantic gate"],
    ],
  },
  // "Building" yang dulu 10 butir dipecah dua, dan Bahasa masuk sebagai sel
  // keenam. Enam habis dibagi 1, 2, dan 3 kolom, jadi kisi .bento tidak pernah
  // menyisakan sel kosong berwarna garis di ukuran layar mana pun. Jangan
  // tambah atau kurangi kelompok tanpa menjaga jumlahnya habis dibagi 3.
  {
    heading: "Backend and data",
    items: [
      ["Python", "Every project on this page"],
      ["FastAPI", "The detector and the family law API"],
      ["Google Classroom API", "Pulling submissions for the grader"],
      ["SQL, MySQL", "Lab modules I wrote for the database course"],
      ["PHP, CodeIgniter, MariaDB", "OpenSID at Pulau Gadang"],
    ],
  },
  {
    heading: "Web and delivery",
    items: [
      ["Next.js", "The detector (JavaScript) and the assistant (TypeScript)"],
      ["Flask, Streamlit, Gradio", "Demo apps for the four brief projects"],
      ["Astro", "This site and the Mandarin course site"],
      ["Docker Compose, GitHub Actions", "Containers and CI for the assistant"],
      ["Git", "Everything above"],
    ],
  },
  {
    // Mandarin ditulis apa adanya: sedang belajar, tanpa sertifikat.
    heading: "Languages",
    items: [
      ["Indonesian", "Native"],
      ["English", "Professional working"],
      ["Arabic", "Elementary, conversational"],
      ["Mandarin", "Beginner, currently learning"],
    ],
  },
];
---

<section class="section" id="skills" aria-labelledby="skills-title">
  <div class="shell">
    <span class="section__label">Toolkit</span>
    <h2 id="skills-title" class="rise">What I use, and where I used it</h2>

    <div class="bento kit rise-group">
      {
        groups.map((g) => (
          <div class="kit__group">
            <h3 class="kit__heading">{g.heading}</h3>
            <dl class="kit__list">
              {g.items.map(([name, where]) => (
                <div class="kit__row">
                  <dt class="figure">{name}</dt>
                  <dd class="caption">{where}</dd>
                </div>
              ))}
            </dl>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .kit {
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }

  .kit__heading {
    font-family: var(--font-mono);
    font-size: var(--size-caption);
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--rule);
  }

  .kit__list {
    margin: 1rem 0 0;
  }

  .kit__row + .kit__row {
    margin-top: 0.9rem;
  }

  .kit__row dd {
    margin: 0.1rem 0 0;
  }
</style>
