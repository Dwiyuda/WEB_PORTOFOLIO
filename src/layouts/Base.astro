---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const lang = Astro.currentLocale === "en" ? "en" : "id";
const canonical = new URL(Astro.url.pathname, Astro.site);
const altId = new URL("/", Astro.site);
const altEn = new URL("/en/", Astro.site);
const ogLocale = lang === "id" ? "id_ID" : "en_US";

// Teks per bahasa. Judul dan deskripsi default di sini; halaman seperti 404
// meneruskan miliknya sendiri lewat props. `other` adalah tujuan tombol
// bahasa: di halaman Indonesia menawarkan Inggris, dan sebaliknya.
const L = {
  id: {
    title: "Dwi Yuda — Portofolio",
    description:
      "Lulusan Teknik Informatika Universitas Islam Riau. Sistem computer vision dan LLM, beserta kerja evaluasi yang menentukan apakah keduanya bisa dipegang.",
    ogAlt:
      "Dwi Yuda. Saya mengaudit pekerjaan saya sendiri sebelum orang lain terpaksa melakukannya. 1.645 citra, sekitar 300 mahasiswa, empat tahun tanpa mengulang mata kuliah, skripsi nilai A.",
    skip: "Lewati ke konten",
    sections: "Bagian",
    nav: {
      timeline: "Linimasa",
      experience: "Pengalaman",
      projects: "Proyek",
      contact: "Kontak",
    },
    toDark: "Ganti ke tema gelap",
    toLight: "Ganti ke tema terang",
    close: "Tutup",
    other: { href: "/en/", label: "EN", title: "Read in English" },
  },
  en: {
    title: "Dwi Yuda Portfolio",
    description:
      "Informatics graduate from Universitas Islam Riau. Computer vision and LLM systems, with the evaluation work that decides whether they hold.",
    ogAlt:
      "Dwi Yuda. I audit my own work before someone else has to. 1,645 images, around 300 undergraduates, four years with no repeated course, thesis graded A.",
    skip: "Skip to content",
    sections: "Sections",
    nav: {
      timeline: "Timeline",
      experience: "Experience",
      projects: "Projects",
      contact: "Contact",
    },
    toDark: "Switch to dark theme",
    toLight: "Switch to light theme",
    close: "Close",
    other: { href: "/", label: "ID", title: "Baca dalam Bahasa Indonesia" },
  },
}[lang];

const title = Astro.props.title ?? L.title;
const description = Astro.props.description ?? L.description;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />

    {/* Dua bahasa untuk satu halaman yang sama. x-default menunjuk Indonesia,
        bahasa yang tayang di akar. */}
    <link rel="alternate" hreflang="id" href={altId} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="x-default" href={altId} />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={L.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="author" content="Dwi Yuda" />

    <link
      rel="preload"
      href="/fonts/literata.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <style is:global>
      /* Self-host, jadi tidak ada permintaan pihak ketiga sebelum teks pertama
         tampil. Variable font, satu berkas untuk seluruh rentang berat.
         Diperbarui lewat: node scripts/fetch-fonts.mjs */
      @font-face {
        font-family: "Bricolage Grotesque";
        src: url("/fonts/bricolage-grotesque.woff2") format("woff2");
        font-weight: 400 800;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "Literata";
        src: url("/fonts/literata.woff2") format("woff2");
        font-weight: 400 700;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "JetBrains Mono";
        src: url("/fonts/jetbrains-mono.woff2") format("woff2");
        font-weight: 400 600;
        font-style: normal;
        font-display: swap;
      }
    </style>

    {/* Supaya mesin pencari tahu halaman ini tentang satu orang, dan
        menampilkan nama serta tautan yang benar saat seseorang mencari
        "Dwi Yuda". Tanpa ini mereka menebak dari teks. */}
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: "Dwi Yuda",
        url: canonical.href,
        image: new URL("/og.png", Astro.site).href,
        jobTitle: "AI Engineer",
        email: "mailto:dwiiyudaaa@gmail.com",
        address: {
          "@type": "PostalAddress",
          addressLocality: "Pekanbaru",
          addressRegion: "Riau",
          addressCountry: "ID",
        },
        alumniOf: {
          "@type": "CollegeOrUniversity",
          name: "Universitas Islam Riau",
        },
        knowsAbout: [
          "Computer vision",
          "Deep learning",
          "Model evaluation",
          "Large language model applications",
        ],
        knowsLanguage: ["Indonesian", "English", "Arabic"],
        sameAs: [
          "https://github.com/Dwiyuda",
          "https://www.linkedin.com/in/dwiyuda",
        ],
      })}
    />

    {/* Dibaca sebelum paint supaya tema pilihan tidak berkedip saat muat.
        Terang tetap default: tanpa pilihan tersimpan, tidak ada yang di-set. */}
    <script is:inline>
      if (localStorage.getItem("theme") === "dark") {
        document.documentElement.dataset.theme = "dark";
      }
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">{L.skip}</a>
    <div class="progress" aria-hidden="true"></div>

    <header class="masthead">
      <div class="shell shell--wide masthead__inner">
        <a class="masthead__name" href="#top">Dwi Yuda</a>

        <nav class="masthead__nav" aria-label={L.sections}>
          <a href="#timeline">{L.nav.timeline}</a>
          <a href="#experience">{L.nav.experience}</a>
          <a href="#projects">{L.nav.projects}</a>
          <a href="#contact">{L.nav.contact}</a>
        </nav>

        <div class="masthead__controls">
          {/* Pengalih bahasa. Tautan biasa ke halaman kembaran, tanpa JS.
              hreflang memberi tahu peramban dan mesin pencari tujuannya. */}
          <a
            class="masthead__lang"
            href={L.other.href}
            hreflang={lang === "id" ? "en" : "id"}
            title={L.other.title}
          >
            {L.other.label}
          </a>

          <button
            type="button"
            id="theme-toggle"
            class="masthead__toggle"
            aria-pressed="false"
            aria-label={L.toDark}
            data-to-dark={L.toDark}
            data-to-light={L.toLight}
          >
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
            <path
              d="M13 9.5A5.5 5.5 0 0 1 6.5 3a5.5 5.5 0 1 0 6.5 6.5Z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.3"
              stroke-linejoin="round"></path>
          </svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    {/* Satu dialog dipakai bersama seluruh gambar yang bisa diperbesar.
        <dialog> asli, jadi Esc, fokus, dan latar gelapnya sudah ditangani
        peramban. */}
    <dialog class="lightbox" id="lightbox">
      <button class="lightbox__close" type="button" aria-label={L.close}>
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
          <path
            d="M4 4l8 8M12 4l-8 8"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"></path>
        </svg>
      </button>
      <img alt="" />
      <p class="lightbox__cap caption"></p>
    </dialog>

    <script>
      const toggle = document.getElementById("theme-toggle");
      const root = document.documentElement;

      const sync = () => {
        const dark = root.dataset.theme === "dark";
        toggle?.setAttribute("aria-pressed", String(dark));
        // Label disetel server-side per bahasa lewat data-to-dark/-to-light.
        if (toggle) {
          toggle.setAttribute(
            "aria-label",
            (dark ? toggle.dataset.toLight : toggle.dataset.toDark) ?? "",
          );
        }
      };

      toggle?.addEventListener("click", () => {
        const flip = () => {
          const dark = root.dataset.theme === "dark";
          if (dark) {
            delete root.dataset.theme;
            localStorage.removeItem("theme");
          } else {
            root.dataset.theme = "dark";
            localStorage.setItem("theme", "dark");
          }
          sync();
        };

        const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (document.startViewTransition && !reduced) {
          // Transisi ditolak kalau ada yang sedang berjalan atau dokumen
          // tak terlihat. Perubahan temanya tetap berlaku, jadi penolakan
          // itu diserap di sini alih-alih jatuh ke konsol.
          const vt = document.startViewTransition(flip);
          vt.ready.catch(() => {});
          vt.finished.catch(() => {});
        } else {
          flip();
        }
      });

      sync();

      // Perbesar gambar. Satu penangan di dokumen, bukan satu per gambar,
      // supaya gambar yang ditambahkan nanti ikut tanpa kode tambahan.
      const box = document.getElementById("lightbox") as HTMLDialogElement | null;

      if (box) {
        const boxImg = box.querySelector("img");
        const boxCap = box.querySelector(".lightbox__cap");

        document.addEventListener("click", (event) => {
          const target = event.target as HTMLElement;
          const img = target.closest<HTMLImageElement>(
            ".screen img, .shot img",
          );

          if (img && boxImg) {
            boxImg.src = img.currentSrc || img.src;
            boxImg.alt = img.alt;
            if (boxCap) {
              const cap = img
                .closest("figure")
                ?.querySelector("figcaption")?.textContent;
              boxCap.textContent = cap?.trim() ?? "";
            }
            box.showModal();
            return;
          }

          // Klik pada latar gelap menargetkan dialognya sendiri.
          if (target === box || target.closest(".lightbox__close")) {
            box.close();
          }
        });
      }

      // Menandai bagian yang sedang dibaca. Pitanya sempit di tengah layar,
      // jadi hanya satu tautan menyala pada satu waktu.
      const links = [
        ...document.querySelectorAll<HTMLAnchorElement>(".masthead__nav a"),
      ];
      const byId = new Map(
        links.map((a) => [a.getAttribute("href")?.slice(1) ?? "", a]),
      );

      if (byId.size) {
        const spy = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              byId
                .get(entry.target.id)
                ?.classList.toggle("is-current", entry.isIntersecting);
            });
          },
          { rootMargin: "-45% 0px -50% 0px" },
        );

        byId.forEach((_, id) => {
          const target = document.getElementById(id);
          if (target) spy.observe(target);
        });
      }
    </script>

    <style>
      .masthead {
        position: sticky;
        top: 0;
        z-index: 10;
        border-bottom: 1px solid var(--rule);
        background: color-mix(in srgb, var(--paper) 88%, transparent);
        backdrop-filter: blur(10px);
      }

      .masthead__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding-block: 0.85rem;
      }

      .masthead__name {
        font-family: var(--font-mono);
        font-size: var(--size-caption);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink-soft);
        text-decoration: none;
        transition: color var(--t-fast) var(--ease-out);
      }

      .masthead__name:hover {
        color: var(--ink);
      }

      .masthead__controls {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }

      /* Pengalih bahasa: huruf mono dalam pil, sebahasa visual dengan tombol
         tema di sebelahnya. */
      .masthead__lang {
        display: grid;
        place-items: center;
        min-width: 2rem;
        height: 2rem;
        padding: 0 0.5rem;
        font-family: var(--font-mono);
        font-size: var(--size-caption);
        letter-spacing: 0.06em;
        color: var(--ink-soft);
        text-decoration: none;
        background: transparent;
        border: 1px solid var(--rule);
        border-radius: 999px;
        transition:
          color var(--t-fast) var(--ease-out),
          border-color var(--t-fast) var(--ease-out);
      }

      .masthead__lang:hover {
        color: var(--ink);
        border-color: var(--ink-soft);
      }

      .masthead__nav {
        display: none;
        gap: 1.5rem;
      }

      @media (min-width: 46rem) {
        .masthead__nav {
          display: flex;
        }
      }

      .masthead__nav a {
        position: relative;
        font-size: var(--size-figure);
        color: var(--ink-soft);
        text-decoration: none;
        transition: color var(--t-fast) var(--ease-out);
      }

      .masthead__nav a:hover {
        color: var(--ink);
      }

      /* Garis bawah tumbuh dari kiri saat disentuh kursor. */
      .masthead__nav a::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: -0.35rem;
        height: 1px;
        background: currentColor;
        transform: scaleX(0);
        transform-origin: 0 50%;
        transition: transform var(--t-mid) var(--ease-out);
      }

      .masthead__nav a:hover::after,
      .masthead__nav a.is-current::after {
        transform: scaleX(1);
      }

      .masthead__nav a.is-current {
        color: var(--ink);
      }

      .masthead__nav a.is-current::after {
        background: var(--verified);
        height: 2px;
      }

      .masthead__toggle {
        display: grid;
        place-items: center;
        width: 2rem;
        height: 2rem;
        padding: 0;
        color: var(--ink-soft);
        background: transparent;
        border: 1px solid var(--rule);
        border-radius: 50%;
        cursor: pointer;
        transition:
          color var(--t-fast) var(--ease-out),
          border-color var(--t-fast) var(--ease-out);
      }

      .masthead__toggle:hover {
        color: var(--ink);
        border-color: var(--ink-soft);
      }

      .lightbox {
        max-width: min(92vw, 68rem);
        max-height: 92vh;
        padding: 0;
        color: var(--ink);
        background: var(--paper);
        border: 1px solid var(--rule);
        border-radius: 3px;
        overflow: visible;
      }

      .lightbox::backdrop {
        background: rgb(10 12 13 / 0.72);
        backdrop-filter: blur(3px);
      }

      .lightbox img {
        display: block;
        max-width: 100%;
        max-height: 80vh;
        width: auto;
        height: auto;
        object-fit: contain;
      }

      .lightbox__cap {
        margin: 0;
        padding: 0.75rem 1rem;
        border-top: 1px solid var(--rule);
      }

      .lightbox__cap:empty {
        display: none;
      }

      .lightbox__close {
        position: absolute;
        top: -0.75rem;
        right: -0.75rem;
        display: grid;
        place-items: center;
        width: 2rem;
        height: 2rem;
        padding: 0;
        color: var(--ink);
        background: var(--paper);
        border: 1px solid var(--rule);
        border-radius: 50%;
        cursor: pointer;
      }

      .lightbox__close:hover {
        border-color: var(--ink-soft);
      }
    </style>
  </body>
</html>
